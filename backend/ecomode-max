def _load_ecomode():
    """Reuse ecomode's sysfs helpers and paths instead of duplicating them."""
    loader = importlib.machinery.SourceFileLoader("ecomode", ECO_PATH)
    spec = importlib.util.spec_from_loader("ecomode", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


# pkexec runs this as root: caching ecomode's bytecode would leave a
# root-owned __pycache__ in /usr/local/bin.
sys.dont_write_bytecode = True
eco = _load_ecomode()

KEEPALIVE_SECS = 30
HOLD_PROFILE = "performance"
HOLD_REASON = "Max power mode (EC keep-alive)"
HOLD_APP_ID = "io.github.souloriginal.powermodes"

# Fans. hp-wmi's pwm1_enable takes 0 (full speed) and 2 ("automatic"). What
# 2 does depends on the board, since the driver handles two families (see
# VICTUS_S_BOARDS in ecomode):
#  * Victus-S boards (8BAB is one): 2 becomes WMI 0x10, 0x27 {0} and 0x2E
#    {0x00, 0x00}, and the EC on 8BAB takes 0x2E {0,0} literally and stops
#    the fans. It keeps them stopped for as long as 0x10 keeps arriving - and
#    every platform_profile write sends one, ours every 30 s and the daemon's
#    when a hold is taken or released. Measured: the fans stood still for a
#    whole Max session. On these boards 2 is never written; full speed is
#    left only through silence: no hold and no profile write for
#    FAN_RELEASE_SECS, until the EC's 120 s timer runs out and it takes the
#    fans back to its own curve.
#  * Every other OMEN (8A17 among them): 2 is 0x27 {0} alone, the plain "max
#    fans off", and the driver itself re-sends "max fans" every 90 s until
#    that write. The EC never times out of it, so fans left at 0 stay at
#    full speed until the next boot (seen on 8A17 after a Max session with
#    fans at max). Here 2 is written whenever the fans should be automatic
#    again: when Max ends or pauses, when boost has cooled down, and at the
#    start when an earlier session left them running.
FANS_MAX = "0"
FANS_AUTO = "2"            # written only where SysfsHw.can_auto says so
FANS_MODES = ("auto", "max", "boost")
VICTUS_S_BOARDS = eco.VICTUS_S_BOARDS
FAN_RELEASE_SECS = 125     # Victus-S: the EC drops user fan state 120 s after the last 0x10
BOOST_ON_C = 85            # boost: full speed at or above this package temperature
BOOST_OFF_C = 65           # ...and hands back once it stays at or below this
BOOST_COOL_SECS = 180      # ...for this long
TEMP_POLL_SECS = 5         # boost only: how often the temperature is checked

POWERD = "nvidia-powerd.service"
GPU_SCAN_SECS = 30      # sampler: how often it looks who holds the dGPU

WATTS_DEFAULT_S = 3
WATTS_MIN_S, WATTS_MAX_S = 1, 30
WATTS_SANE_MAX = 1000   # W; anything above is a counter glitch, not a reading


class Keeper:
    """The keep-alive state machine, free of I/O so it can be tested.

    fans   "auto" leaves the fans to the firmware, "max" runs them at full
           speed, "boost" does so while the CPU package is hot (on_temp)
    hw     read_profile() -> str|None, write_profile(v) -> (ok, err),
           write_pwm(v) -> (ok, err) with FANS_MAX or FANS_AUTO,
           fans_at_max() -> True|False|None (what the EC says),
           can_auto: whether FANS_AUTO may be written on this board (see
           FANS_AUTO), on_ac() -> True|False|None, read_temp() -> °C|None
    ppd    hold(profile, reason, app_id) -> cookie, release(cookie)
    store  save(state), clear(), save_last(entry), stop_reason() -> str|None
    clock  time() -> float
    session alive() -> True|False|None: whether the user who started Max is
           still logged in; None when logind could not say
    settle Victus-S only: seconds to stay silent before the first hold, while
           the EC takes back fans an earlier session left at full speed
    """

    def __init__(self, fans, hw, ppd, store, clock, session, settle=0):
        self.fans = fans
        self.hw = hw
        self.ppd = ppd
        self.store = store
        self.clock = clock
        self.session = session
        # Where automatic can be written there is nothing to wait for: the
        # first round writes it.
        self.can_auto = bool(getattr(hw, "can_auto", False))
        self.settle = 0 if self.can_auto else settle
        self.cookie = None
        self.paused = False
        self.profile_at_pause = None
        self.running = False
        self.state = {}
        self._own_releases = set()
        # Whether full speed is what we command right now.
        self.fans_hot = fans == "max"
        # When the EC lets go of full speed if no further 0x10 reaches it.
        self.fans_armed_until = None
        # While set, Max is silent so that the EC can take the fans back.
        self.settle_until = None
        # One extra wait per session at most, for full speed found still on.
        self.resettled = False
        self.cool_since = None      # boost: since when it has been cool

    def now(self):
        return int(self.clock.time())

    def start(self, pid):
        now = self.now()
        if self.settle > 0:
            # Until the EC has taken the fans back, any 0x10 from us would
            # keep them at full speed; a stop meanwhile passes the rest on.
            self.settle_until = now + self.settle
            self.fans_armed_until = self.settle_until
        self.state = {
            "pid": pid, "since": now, "fans": self.fans,
            "state": "starting", "pause_reason": None,
            "last_tick": None, "last_tick_ok": None, "last_error": None,
        }
        self.running = True
        return self.tick()

    def tick(self):
        """One keep-alive round. Returns False once the keeper has stopped."""
        if not self.running or self._logged_out():
            return False
        # No mains supply to ask (None) counts as AC: pausing on such a
        # reading would quietly switch the mode off.
        if self.hw.on_ac() is False:
            # Nothing is watched on battery, so a cool spell that began
            # before starts over once AC is back.
            self.cool_since = None
            self._pause("battery")
        elif self.settle_until is not None and self.now() < self.settle_until:
            self._pause("fans settling")
        elif (not self.can_auto and self.fans != "max" and not self.fans_hot
              and not self.resettled and self.hw.fans_at_max() is True):
            # Victus-S: full speed this session did not ask for, and every
            # tick of ours would keep it: be silent for one hand-back. Once
            # only - if the EC still holds it after that, it is not ours, and
            # Max goes on. (Elsewhere _keep_alive simply writes automatic.)
            self.resettled = True
            self.settle_until = self.now() + FAN_RELEASE_SECS
            self._pause("fans settling")
        else:
            self.settle_until = None
            self._keep_alive()
        if self.running:
            self._save()
        return self.running

    def _logged_out(self):
        """Ends Max once logind says the user is gone. With lingering on,
        the user manager - and BindsTo= with it - outlives the logout, so
        every round asks, paused or settling alike. Only a definite answer
        counts: a question logind left unanswered (None) ends nothing."""
        if self.session.alive() is False:
            self.stop("logout or shutdown")
            return True
        return False

    def _save(self):
        # Where automatic can be written a pause hands the fans back (and
        # resuming runs them up again), so the record follows the EC.
        hot = self.fans_hot and not (self.can_auto and self.paused)
        self.state.update(fans_state="max" if hot else "auto",
                          settle_until=self.settle_until,
                          fans_armed_until=self.fans_armed_until)
        self.store.save(self.state)

    def _reached_ec(self):
        """A hold, a release (the daemon writes the profile for both), a
        profile rewrite or a fan write has just reached the EC: at full
        speed, that keeps the fans there FAN_RELEASE_SECS past now. Full
        speed is what the EC says, not only what this session commands: one
        left over from an earlier session is kept there just the same, and
        the record has to say so (seen: every Max toggle after a "max"
        session kept the fans at full speed two more minutes, unannounced).
        Where automatic can be written the EC does not time out and nothing
        is armed: the fans are written back instead."""
        if self.can_auto:
            return
        if self.fans_hot or self.hw.fans_at_max() is True:
            self.fans_armed_until = self.now() + FAN_RELEASE_SECS

    def _fans_back(self, force=False):
        """Where automatic can be written: fans the EC holds at full speed
        while this session does not ask for it (or, with force, whatever it
        asks: a pause) go back to the firmware's curve. Returns the error,
        or None."""
        if not self.can_auto or (self.fans_hot and not force):
            return None
        if self.hw.fans_at_max() is not True:
            return None
        ok, err = self.hw.write_pwm(FANS_AUTO)
        return None if ok else f"pwm1_enable: {err}"

    def _keep_alive(self):
        if self.paused:
            # A profile picked by hand while we were paused is the user's
            # decision; taking performance back would override it.
            if self.hw.read_profile() != self.profile_at_pause:
                self.stop("profile changed")
                return
            self.paused = False

        fresh = False
        if self.cookie is None:
            try:
                self.cookie = self.ppd.hold(HOLD_PROFILE, HOLD_REASON, HOLD_APP_ID)
            except Exception as exc:      # D-Bus errors share no useful base
                self.stop(f"hold failed: {exc}")
                return
            fresh = True

        errors = []
        profile = self.hw.read_profile()
        if not fresh and profile is not None and profile != HOLD_PROFILE:
            # Held since an earlier tick, yet the profile moved. The hold is
            # gone without a signal (daemon restart) or someone overrode it.
            # Claiming "holding performance" from here on would be a lie.
            self._release()
            self.stop("profile changed")
            return
        if profile is None:
            errors.append("platform_profile unreadable")
        else:
            # Rewriting the same value is the point: every write makes
            # hp-wmi send the 0x10 query that restarts the EC's 120 s timer.
            ok, err = self.hw.write_profile(profile)
            if not ok:
                errors.append(f"platform_profile: {err}")
        if self.fans_hot:
            ok, err = self.hw.write_pwm(FANS_MAX)
            if not ok:
                errors.append(f"pwm1_enable: {err}")
        else:
            # Left at full speed by an earlier session, by boost before a
            # pause, or by anything else: back to the firmware's curve,
            # where that can be written.
            err = self._fans_back()
            if err:
                errors.append(err)
        self._reached_ec()
        self.state.update(state="active", pause_reason=None,
                          last_tick=self.now(), last_tick_ok=not errors,
                          last_error="; ".join(errors) or None)

    def _pause(self, reason):
        # Victus-S: no fan write here or anywhere on the way out, the only
        # "back to automatic" there stops the fans (see FANS_AUTO).
        if not self.paused:
            if self.can_auto:
                self._fans_back(force=True)
                if self.fans == "boost":
                    # Starts over from the temperature once back.
                    self.fans_hot = False
                    self.cool_since = None
            self._release()
            self.paused = True
            self.profile_at_pause = self.hw.read_profile()
            self.state.update(last_tick_ok=True, last_error=None)
        self.state.update(state="paused", pause_reason=reason,
                          last_tick=self.now())

    def _release(self):
        if self.cookie is None:
            return
        cookie, self.cookie = self.cookie, None
        self._own_releases.add(cookie)
        try:
            self.ppd.release(cookie)
        except Exception:                 # the daemon may already be gone
            pass
        self._reached_ec()

    def on_temp(self, temp_c):
        """Boost: cmd_run hands in the package temperature every
        TEMP_POLL_SECS. Nothing is decided without a reading, nor on battery,
        where nothing is sent to the EC anyway."""
        if (self.fans != "boost" or not self.running or temp_c is None
                or self.state.get("pause_reason") == "battery"):
            return
        if self.settle_until is not None:
            if temp_c >= BOOST_ON_C:
                # Hot again before the EC took the fans back: they are still
                # at full speed, so keep them there and resume at once.
                self.settle_until = None
                self.fans_hot = True
                self.tick()
            return
        if not self.fans_hot:
            # Nothing is run up for a session that has already ended.
            if temp_c >= BOOST_ON_C and not self._logged_out():
                self.fans_hot = True
                self.cool_since = None
                ok, err = self.hw.write_pwm(FANS_MAX)
                self._reached_ec()
                if not ok:
                    self.state.update(last_tick_ok=False,
                                      last_error=f"pwm1_enable: {err}")
                self._save()
            return
        if temp_c > BOOST_OFF_C:
            self.cool_since = None
            return
        if self.cool_since is None:
            self.cool_since = self.now()
        if self.now() - self.cool_since >= BOOST_COOL_SECS:
            self._hand_back()

    def _hand_back(self):
        """Boost has cooled down: the fans go back to the firmware's curve.
        On Victus-S there is no fan write that means "automatic" (see
        FANS_AUTO), so Max falls silent until the EC takes the fans back,
        then carries on without them."""
        if self.can_auto:
            self.fans_hot = False
            self.cool_since = None
            err = self._fans_back()
            if err:
                self.state.update(last_tick_ok=False, last_error=err)
            self._save()
            return
        self._pause("fans settling")      # releasing at full speed: one more 0x10
        self.fans_hot = False
        self.cool_since = None
        self.settle_until = self.now() + FAN_RELEASE_SECS
        self._save()

    def on_released(self, cookie):
        """power-profiles-daemon dropped a hold of ours.

        Our own release (pausing on battery) echoes back here and must not
        end the mode. Any other release of our cookie means the user picked
        a profile by hand, which ends Max.
        """
        if cookie in self._own_releases:
            self._own_releases.discard(cookie)
            return
        if cookie == self.cookie:
            self.cookie = None
            self._reached_ec()            # the daemon wrote the picked profile
            self.stop("profile changed")

    def on_resume(self):
        """Back from suspend: the EC may have reset, so do not wait 30 s."""
        self.tick()

    def on_terminate(self):
        self.stop(self.store.stop_reason() or "logout or shutdown")

    def stop(self, reason):
        if not self.running:
            return
        self.running = False
        if self.can_auto:
            self.fans_hot = False
            self._fans_back()             # nothing can end Max twice; errors go unreported
        self._release()
        self.store.clear()
        now, armed = self.now(), self.fans_armed_until
        # Victus-S: a session that leaves the fans at full speed says until
        # when, and the next one with auto or boost stays silent that long
        # (cmd_on).
        self.store.save_last({
            "ended_at": now, "reason": reason,
            "fans_armed_until": armed if armed is not None and armed > now else None})


class WattMeter:
    """Average package power between consecutive RAPL energy readings.

    Pure arithmetic, so it can be tested: the caller supplies the counter
    value and a clock that keeps running through suspend (CLOCK_BOOTTIME).
    """

    def __init__(self, range_uj, max_gap):
        self.range_uj = range_uj    # the counter wraps here; None if unknown
        self.max_gap = max_gap      # seconds; a longer gap is a suspend or stall
        self.last = None

    def feed(self, energy_uj, t):
        """Watts since the previous reading, or None when there is no
        trustworthy figure: the first reading, a clock that did not advance,
        a gap long enough to span a suspend, a counter that ran backwards
        with no known range, or a glitch above WATTS_SANE_MAX."""
        prev, self.last = self.last, (energy_uj, t)
        if prev is None:
            return None
        dt = t - prev[1]
        if dt <= 0 or dt > self.max_gap:
            # After a suspend the counter may have been reset; folding a
            # reset over the range would produce a plausible-looking lie.
            return None
        de = energy_uj - prev[0]
        if de < 0:
            if not self.range_uj:
                return None
            de += self.range_uj         # the counter wrapped
        watts = de / dt / 1_000_000
        if watts > WATTS_SANE_MAX:
            return None
        return round(watts, 1)


