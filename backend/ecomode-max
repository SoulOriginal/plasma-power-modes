def _write_json(path, data):
    eco.make_state_dir()         # every file written here lives in STATE_DIR
    tmp = path + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(data, fh)
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)


class FileStore:
    """State files under /run/ecomode - tmpfs, so gone after a reboot."""

    def save(self, state):
        _write_json(eco.MAX_STATE_FILE, state)

    def clear(self):
        for path in (eco.MAX_STATE_FILE, eco.MAX_STOP_FLAG):
            try:
                os.remove(path)
            except OSError:
                pass

    def save_last(self, entry):
        _write_json(eco.MAX_LAST_FILE, entry)

    def stop_reason(self):
        return eco.read_path(eco.MAX_STOP_FLAG)


class SysfsHw:
    def __init__(self, hwmon_dir, board=None):
        self.pwm_path = f"{hwmon_dir}/pwm1_enable" if hwmon_dir else None
        # Whether "automatic" may be written here (see FANS_AUTO). A board
        # that cannot be read is treated as Victus-S: a write that merely
        # fails to hand the fans back costs less than one that stops them.
        self.can_auto = (self.pwm_path is not None and board is not None
                         and board not in VICTUS_S_BOARDS)

    @classmethod
    def detect(cls):
        return cls(eco.find_hp_hwmon(), eco.read_path(eco.BOARD_NAME))

    def read_profile(self):
        return eco.read_path(eco.PLATFORM_PROFILE)

    def write_profile(self, value):
        return eco.write_path(eco.PLATFORM_PROFILE, value)

    def write_pwm(self, value):
        # The one place pwm1_enable is written: full speed, or automatic on
        # the boards where that does not stop the fans (see FANS_AUTO).
        if value == FANS_AUTO and not self.can_auto:
            return False, "refusing pwm1_enable=2: it stops the fans on this board"
        if value not in (FANS_MAX, FANS_AUTO):
            return False, f"refusing pwm1_enable={value}"
        if not self.pwm_path:
            return False, "no hp fan control"
        return eco.write_path(self.pwm_path, value)

    def fans_at_max(self):
        """What the EC says: True while it holds full speed, False on its own
        curve, None without a reading. hp-wmi reads this from the firmware."""
        return {"0": True, "2": False}.get(
            eco.read_path(self.pwm_path) if self.pwm_path else None)

    def on_ac(self):
        return eco.on_ac()

    def read_temp(self):
        return eco.pkg_temp_c()


def fans_to_auto(hw):
    """Fans left at full speed, taken back where that can be written.
    Returns what the fans are now, for the report, or None when there is
    nothing to say."""
    if not hw.can_auto or hw.fans_at_max() is not True:
        return None
    ok, err = hw.write_pwm(FANS_AUTO)
    return "automatic" if ok else f"still at full speed: {err}"


def _gio():
    # Imported lazily: the Keeper and the CLI checks load without PyGObject.
    import gi
    gi.require_version("Gio", "2.0")
    from gi.repository import Gio, GLib
    return Gio, GLib


def _signal_add():
    """GLibUnix.signal_add, or GLib.unix_signal_add on an older GLib.

    PyGObject on GLib 2.88 deprecates the latter and would log a warning on
    every keeper start.
    """
    import gi
    _, GLib = _gio()
    try:
        gi.require_version("GLibUnix", "2.0")
        from gi.repository import GLibUnix
        return GLibUnix.signal_add
    except (ImportError, ValueError):
        return GLib.unix_signal_add


class DbusPpd:
    def __init__(self, bus):
        self.bus = bus

    def _call(self, method, params, reply):
        Gio, GLib = _gio()
        return self.bus.call_sync(
            PPD_BUS_NAME, PPD_PATH, PPD_IFACE, method, params,
            GLib.VariantType.new(reply) if reply else None,
            Gio.DBusCallFlags.NONE, 5000, None)

    def hold(self, profile, reason, app_id):
        _, GLib = _gio()
        params = GLib.Variant("(sss)", (profile, reason, app_id))
        return self._call("HoldProfile", params, "(u)").unpack()[0]

    def release(self, cookie):
        _, GLib = _gio()
        self._call("ReleaseProfile", GLib.Variant("(u)", (cookie,)), None)


def dbus_error_name(exc):
    """The D-Bus error behind a GLib.Error, e.g.
    org.freedesktop.login1.NoSuchUser; None for anything else."""
    try:
        Gio, _ = _gio()
        return Gio.DBusError.get_remote_error(exc)
    except Exception:                     # not a GLib.Error, or no GLib at all
        return None


class LogindSession:
    """Whether a user is still logged in, as logind tells it over the bus.

    The keeper asks this every round: BindsTo=user@UID.service alone misses
    the logout when lingering keeps the user manager running. The keeper
    has a GLib loop and a bus connection anyway; the sampler, which has
    neither, asks through libsystemd instead (SdLoginSession). Nothing here
    reads logind's private files under /run/systemd/users itself.
    """

    def __init__(self, bus, uid):
        self.bus = bus
        self.uid = uid
        self.unsure_logged = False

    def _call(self, path, iface, method, params, reply):
        Gio, GLib = _gio()
        return self.bus.call_sync(
            LOGIND_BUS_NAME, path, iface, method, params,
            GLib.VariantType.new(reply), Gio.DBusCallFlags.NONE, 2000,
            None).unpack()[0]

    def alive(self):
        """True while logged in, False once logged out (lingering or not),
        None when logind could not say."""
        try:
            _, GLib = _gio()
            path = self._call(LOGIND_PATH, LOGIND_IFACE, "GetUser",
                              GLib.Variant("(u)", (self.uid,)), "(o)")
            state = self._call(path, "org.freedesktop.DBus.Properties", "Get",
                               GLib.Variant("(ss)", (LOGIND_USER_IFACE, "State")),
                               "(v)")
        except Exception as exc:
            if dbus_error_name(exc) == LOGIND_NO_SUCH_USER:
                return False              # not logged in, not lingering either
            self._unsure(exc)
            return None
        logged_in = USER_LOGGED_IN.get(state)
        if logged_in is None:
            self._unsure(f"unknown user state {state!r}")
        return logged_in

    def _unsure(self, why):
        # A D-Bus hiccup must not end a mode, only a definite answer can; but
        # the journal should say once that the check is not working.
        if not self.unsure_logged:
            self.unsure_logged = True
            print(f"ecomode-max: cannot tell from logind whether uid {self.uid} "
                  f"is logged in ({why}); carrying on", file=sys.stderr, flush=True)


# libsystemd's ABI name. ctypes.util.find_library() would run ldconfig in a
# subprocess just to arrive at the same name.
SD_LOGIN_LIB = "libsystemd.so.0"
_sd_login = None        # (sd_uid_get_state, free) once loaded; False if it cannot be


def _sd_login_fns():
    """libsystemd's sd_uid_get_state() and libc's free(), loaded on first use
    and kept; None when libsystemd cannot be loaded (tried once)."""
    global _sd_login
    if _sd_login is None:
        import ctypes
        try:
            get_state = ctypes.CDLL(SD_LOGIN_LIB).sd_uid_get_state
            get_state.argtypes = [ctypes.c_uint, ctypes.POINTER(ctypes.c_void_p)]
            get_state.restype = ctypes.c_int
            free = ctypes.CDLL(None).free       # the free that pairs with its malloc
            free.argtypes = [ctypes.c_void_p]
            free.restype = None
            _sd_login = (get_state, free)
        except (OSError, AttributeError):
            _sd_login = False
    return _sd_login or None


def uid_state_native(uid):
    """logind's state for uid through sd_uid_get_state(), sd-login's public
    call over logind's own per-user state: "active", "online", "lingering",
    "closing", "offline" (also for a uid logind has never seen) or a word
    added later. None when libsystemd is missing or the call fails."""
    fns = _sd_login_fns()
    if fns is None:
        return None
    import ctypes
    get_state, free = fns
    out = ctypes.c_void_p()
    if get_state(uid, ctypes.byref(out)) < 0 or not out.value:
        return None
    try:
        return ctypes.string_at(out.value).decode("ascii", "replace")
    finally:
        free(out.value)                   # libsystemd's copy is ours to free


class SdLoginSession:
    """The sampler's session check: LogindSession's answer, read in-process
    through libsystemd. The sampler wakes every few seconds and needs no
    main loop; PyGObject and a bus connection for one question per round
    cost it about 13 MB of resident memory (21 -> 34 MB, measured)."""

    def __init__(self, uid, read_state=None):
        self.uid = uid
        self.read_state = read_state or uid_state_native
        self.unsure_logged = False

    def alive(self):
        """True while logged in, False once logged out (lingering or not),
        None when there is no answer."""
        try:
            state = self.read_state(self.uid)
        except Exception as exc:          # never let the check end the loop
            state, why = None, exc
        else:
            why = "no answer from libsystemd" if state is None else \
                f"unknown user state {state!r}"
        logged_in = USER_LOGGED_IN.get(state)
        if logged_in is None and not self.unsure_logged:
            self.unsure_logged = True
            print(f"ecomode-max: cannot tell from logind whether uid {self.uid} "
                  f"is logged in ({why}); carrying on", file=sys.stderr, flush=True)
        return logged_in


def ppd_available():
    try:
        Gio, GLib = _gio()
        bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        reply = bus.call_sync(
            "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
            "NameHasOwner", GLib.Variant("(s)", (PPD_BUS_NAME,)),
            GLib.VariantType.new("(b)"), Gio.DBusCallFlags.NONE, 2000, None)
        return reply.unpack()[0]
    except Exception:
        return False


# ---------------------------------------------------------------------------
# commands
# ---------------------------------------------------------------------------

def sh(cmd):
    return subprocess.run(cmd, capture_output=True, text=True)


@contextlib.contextmanager
def state_lock():
    """An exclusive flock on /run/ecomode/lock for as long as a command runs.

    Root's alone (0600 in a root-owned directory), so no other user can take
    it and stall Max. The kernel lets go when the file is closed, and so when
    the process dies, too.
    """
    eco.make_state_dir()
    fd = os.open(os.path.join(eco.STATE_DIR, "lock"),
                 os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)


def locked(command):
    """Runs a command from start to end under state_lock().

    on, off and watts each read what runs and then act on it. Run side by
    side - Plasma's Apply sets two options one after the other, two widgets
    start at login, clicks come quickly - they act on each other's stale
    view: "unit already loaded", or an old interval that sticks.
    """
    @functools.wraps(command)
    def run(args):
        with state_lock():
            # `ecomode off`, run from in here, takes the same lock; it must
            # not wait for the one its parent holds.
            os.environ[eco.LOCK_HELD_ENV] = "1"
            try:
                return command(args)
            finally:
                os.environ.pop(eco.LOCK_HELD_ENV, None)
    return run


def invoking_uid():
    """The user behind pkexec (or sudo): whose session Max belongs to."""
    for var in ("PKEXEC_UID", "SUDO_UID"):
        value = os.environ.get(var, "")
        if value.isdigit():
            return int(value)
    return None


def unit_active():
    return sh(["systemctl", "is-active", "--quiet", UNIT]).returncode == 0


def watts_active():
    return sh(["systemctl", "is-active", "--quiet", WATTS_UNIT]).returncode == 0


def watts_entry(meter, interval, boottime, walltime, gpu=None):
    """One sampler round: the record to publish, or None when this round has
    no trustworthy reading."""
    raw = eco.read_path(f"{eco.RAPL}/energy_uj")
    if not raw or not raw.isdigit():
        return None
    watts = meter.feed(int(raw), boottime)
    if watts is None:
        return None
    return {"cpu_w": watts, "battery_w": eco.battery_draw_w(),
            "cpu_limit": eco.cpu_limit_now(),
            "gpu": gpu.reading() if gpu is not None else None,
            "at": int(walltime), "interval": interval}


# What the sampler publishes of a GPU reading.
GPU_SAMPLE_KEYS = ("power_w", "limit_w", "util_pct", "temp_c", "gr_mhz",
                   "mem_mhz", "pstate", "reasons")


class GpuWatch:
    """The sampler's view of the dGPU.

    Asking the driver keeps the GPU awake, and the sampler asks every few
    seconds: if nothing else used the card, the sampler alone could keep it
    from ever powering down. So it asks only while some *other* process
    holds the GPU, which keeps it awake anyway. Who holds it is looked up
    every GPU_SCAN_SECS (a walk over /proc), and again as soon as the GPU
    wakes.
    """

    def __init__(self, clock=time.monotonic, scan_secs=GPU_SCAN_SECS):
        self.clock = clock
        self.scan_secs = scan_secs
        self.last_scan = None
        self.held = False

    def reading(self):
        status = eco.gpu_runtime()["status"]
        if status != "active":
            self.last_scan = None         # rescan the moment it wakes
            self.held = False
            return {"state": status}
        now = self.clock()
        if self.last_scan is None or now - self.last_scan >= self.scan_secs:
            self.last_scan = now
            self.held = bool(eco.keeps_awake(eco.gpu_holders(exclude={os.getpid()})))
        if not self.held:
            return {"state": "active", "held": False}
        q = eco.gpu_query() or {}
        out = {k: q.get(k) for k in GPU_SAMPLE_KEYS}
        out.update(state="active", held=True)
        return out


def powerd_present():
    res = sh(["systemctl", "show", "-p", "LoadState", "--value", POWERD])
    return res.returncode == 0 and res.stdout.strip() == "loaded"


def start_powerd():
    """Start Dynamic Boost for Max, unless it runs already - then it is not
    ours to stop later. Returns an error, or None."""
    if os.path.exists(eco.POWERD_FLAG):
        return None
    if sh(["systemctl", "is-active", "--quiet", POWERD]).returncode == 0:
        return None
    if not powerd_present():
        return "nvidia-powerd is not installed"
    res = sh(["systemctl", "start", POWERD])
    if res.returncode != 0:
        return "nvidia-powerd: " + ((res.stderr or "").strip() or "did not start")
    eco.make_state_dir()
    with open(eco.POWERD_FLAG, "w") as fh:
        fh.write("max")
    os.chmod(eco.POWERD_FLAG, 0o644)
    return None


def stop_powerd():
    """Stop Dynamic Boost if Max started it; leave it alone otherwise."""
    if not os.path.exists(eco.POWERD_FLAG):
        return
    sh(["systemctl", "stop", POWERD])
    try:
        os.remove(eco.POWERD_FLAG)
    except OSError:
        pass


def user_manager_active(uid):
    return sh(["systemctl", "is-active", "--quiet",
               f"user@{uid}.service"]).returncode == 0


def transient_unit_cmd(unit, description, uid, stop_post, argv):
    """systemd-run for a root helper that lives only as long as the user's
    session: bound to their manager, locked down, writing only /run/ecomode."""
    user_unit = f"user@{uid}.service"
    return [
        "systemd-run", f"--unit={unit}", "--collect", "--quiet",
        f"--description={description}",
        "-p", f"BindsTo={user_unit}", "-p", f"After={user_unit}",
        "-p", "After=power-profiles-daemon.service",
        "-p", f"ExecStopPost={stop_post}",
        "-p", "NoNewPrivileges=yes", "-p", "ProtectHome=yes",
        "-p", "PrivateTmp=yes", "-p", "ProtectSystem=strict",
        "-p", f"ReadWritePaths={eco.STATE_DIR}",
        "--", *argv,
    ]


def systemd_run_cmd(uid, fans, settle):
    return transient_unit_cmd(UNIT, "HP OMEN Max power keep-alive", uid,
                              f"{SELF_PATH} cleanup",
                              [SELF_PATH, "run", "--uid", str(uid),
                               "--fans", fans, "--settle", str(settle)])


def settle_for(fans, last, now):
    """Seconds a new session stays silent before its first hold.

    `last` is the previous session's end record. If that session left the
    fans at full speed, any 0x10 before the EC has taken them back keeps
    them there - fine for "max", not for "auto" or "boost".
    """
    armed = (last or {}).get("fans_armed_until")
    # Written as whole seconds by this file; anything else is not ours.
    if fans == "max" or isinstance(armed, bool) or not isinstance(armed, int):
        return 0
    # Never more than one hand-back: it runs from the last 0x10, which cannot
    # lie ahead of now, so a longer wait only means the clock was set back.
    return max(0, min(math.ceil(armed - now), FAN_RELEASE_SECS))


def settle_needed(fans, last, now, ec_at_max, can_auto=False):
    """settle_for(), checked against the EC itself: the record's remainder
    when it has one; with none, while the EC holds full speed now, an "auto"
    or "boost" session waits a whole hand-back - the record misses what it
    did not cause. Where automatic can be written there is nothing to wait
    for: the keeper writes it."""
    if can_auto:
        return 0
    settle = settle_for(fans, last, now)
    if settle == 0 and fans != "max" and ec_at_max is True:
        return FAN_RELEASE_SECS
    return settle


def watts_run_cmd(uid, interval):
    return transient_unit_cmd(WATTS_UNIT, "CPU package watts sampler", uid,
                              f"-/usr/bin/rm -f {eco.WATTS_FILE}",
                              [SELF_PATH, "watts-run", "--uid", str(uid),
                               "--interval", str(interval)])


def fail(args, reason):
    eco.emit({"ok": False, "reason": reason}, args)
    return 1


def wait_for_state(timeout=3.0, step=0.1):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        state = eco.max_state()
        # "paused" covers a keeper that starts by letting the fans settle.
        if state and state.get("state") in ("active", "paused"):
            return state
        time.sleep(step)
    return None


def stop_unit(reason):
    """Stop the service, first telling the keeper why so its record is right.

    The reason goes in its own file: the keeper rewrites max.json every tick
    and would overwrite a flag kept there.
    """
    eco.make_state_dir()
    with open(eco.MAX_STOP_FLAG, "w") as fh:
        fh.write(reason)
    sh(["systemctl", "stop", UNIT])


@locked
def cmd_on(args):
    uid = invoking_uid()
    if uid is None:
        return fail(args, "cannot tell which user asked; run through pkexec")
    supported, why = eco.max_support()
    if not supported:
        return fail(args, why)
    if args.fans in ("max", "boost") and not eco.fans_controllable():
        return fail(args, "no hp fan control (hwmon 'hp' with pwm1_enable)")
    if args.fans == "boost" and eco.pkg_temp_c() is None:
        return fail(args, "no CPU package temperature sensor")
    if not ppd_available():
        return fail(args, "power-profiles-daemon is not running")
    if not user_manager_active(uid):
        return fail(args, f"no running session for uid {uid}")

    boost = getattr(args, "gpu_boost", False)
    # The dGPU's LACT profile is independent of the keeper: taken or given
    # back here, whether or not the unit restarts below. A name LACT does
    # not know refuses Max rather than silently running without it.
    gpu_profile = getattr(args, "gpu_profile", None) or ""
    gpu_report = {"want": gpu_profile or None, "ok": True, "error": None}
    if gpu_profile:
        ok, err = eco.gpu_profile_take(gpu_profile)
        if not ok:
            return fail(args, f"LACT profile {gpu_profile!r}: {err}")
    else:
        ok, err, _ = eco.gpu_profile_give_back()
        gpu_report.update(ok=ok, error=err)
    running = eco.max_state()
    if running and running.get("fans") == args.fans:
        boost_error = start_powerd() if boost else stop_powerd()
        eco.emit({"ok": True, "noop": True, "state": eco.max_public(running),
                  "gpu_boost": os.path.exists(eco.POWERD_FLAG),
                  "gpu_boost_error": boost_error, "gpu_profile": gpu_report}, args)
        return 0
    if running or unit_active():
        stop_unit("restart")

    if eco.is_on():
        # Already root, so reuse the exact-restore path of `ecomode off`
        # rather than duplicating it here.
        res = sh([ECO_PATH, "--json", "off"])
        if res.returncode != 0:
            detail = (res.stdout or "").strip() or (res.stderr or "").strip()
            return fail(args, "could not restore eco first: " + detail)

    # Read before it goes below: it may say the EC still holds the fans at
    # full speed - also for the session stopped just above.
    hw = SysfsHw.detect()
    settle = settle_needed(args.fans, eco.read_json(eco.MAX_LAST_FILE), time.time(),
                           hw.fans_at_max() if hw.pwm_path else None, hw.can_auto)
    FileStore().clear()
    eco.make_state_dir()
    sh(["systemctl", "reset-failed", UNIT])
    # Only this start's own end record explains a failure. An older one (an
    # earlier session's "off", or the "restart" the unit stopped above wrote
    # a moment ago) would send the user chasing the wrong cause, so it goes.
    try:
        os.remove(eco.MAX_LAST_FILE)
    except OSError:
        pass
    res = sh(systemd_run_cmd(uid, args.fans, settle))
    if res.returncode != 0:
        return fail(args, "systemd-run failed: " + (res.stderr or "").strip())

    state = wait_for_state()
    if state is None:
        last = eco.read_json(eco.MAX_LAST_FILE) or {}
        eco.gpu_profile_give_back()       # Max did not start: nothing to hold it for
        return fail(args, last.get("reason") or "keep-alive did not start")
    # Dynamic Boost is extra: Max runs without it, the widget says why not.
    boost_error = start_powerd() if boost else None
    if eco.max_state() is None:
        # The keeper ended in the meantime and its cleanup has run already;
        # nothing would stop a daemon started after it.
        stop_powerd()
    eco.emit({"ok": True, "state": eco.max_public(state),
              "gpu_boost": os.path.exists(eco.POWERD_FLAG),
              "gpu_boost_error": boost_error, "gpu_profile": gpu_report}, args)
    return 0


@locked
def cmd_off(args):
    """Max stopped, and - where automatic can be written - fans left at full
    speed taken back, also when Max was not on: Normal is what puts the
    machine right after a crash or an older version."""
    if eco.max_state() is None and not unit_active():
        stop_powerd()             # left behind by a Max that ended as it started
        # The dGPU's LACT profile too, for a record a crash left behind.
        gpu_ok, gpu_err, gpu_restored = eco.gpu_profile_give_back()
        eco.emit({"ok": True, "noop": True, "msg": "max is already off",
                  "fans": fans_to_auto(SysfsHw.detect()),
                  "gpu_profile": {"restored": gpu_restored, "ok": gpu_ok,
                                  "error": gpu_err}}, args)
        return 0
    stop_unit("off")
    if unit_active():
        eco.emit({"ok": False, "msg": "service did not stop"}, args)
        return 1
    # No keeper runs without its unit, so a max.json still here is stale: its
    # keeper died without cleaning up, and a live pid in it is someone else's.
    FileStore().clear()
    stop_powerd()                 # cleanup did it already, unless it failed
    gpu_ok, gpu_err, gpu_restored = eco.gpu_profile_give_back()
    eco.emit({"ok": True, "msg": "stopped", "fans": fans_to_auto(SysfsHw.detect()),
              "gpu_profile": {"restored": gpu_restored, "ok": gpu_ok,
                              "error": gpu_err}}, args)
    return 0


@locked
def cmd_fans(args):
    """The fans by hand, outside Max: automatic (the usual want: a leftover
    full speed) or full speed. Max's own keeper is left alone: it would
    write its own choice back within a round anyway."""
    if eco.max_state() is not None:
        return fail(args, "max is on; pick the fans in the widget or stop it first")
    hw = SysfsHw.detect()
    if hw.pwm_path is None:
        return fail(args, "no hp fan control (hwmon 'hp' with pwm1_enable)")
    ok, err = hw.write_pwm(FANS_AUTO if args.mode == "auto" else FANS_MAX)
    if not ok:
        return fail(args, f"pwm1_enable: {err}")
    eco.emit({"ok": True, "fans": args.mode,
              "pwm_enable": eco.read_path(hw.pwm_path)}, args)
    return 0


def from_systemd():
    """run, cleanup and watts-run are started by systemd only; pkexec clears
    the environment, so INVOCATION_ID cannot be carried in through it."""
    if os.environ.get("INVOCATION_ID"):
        return True
    print("ecomode-max: 'run', 'cleanup' and 'watts-run' are started by "
          "systemd only", file=sys.stderr)
    return False


class KeeperLoop:
    """cmd_run's GLib callbacks around a Keeper.

    GLib only prints an exception raised in a callback, and a timeout whose
    callback raised is dropped for good: the keep-alive would stop while
    max.json still said Max runs. So an unexpected error ends Max, with the
    error as its reason, and quits the loop; the traceback goes to the
    journal.
    """

    def __init__(self, keeper, hw, loop):
        self.keeper = keeper
        self.hw = hw
        self.loop = loop
        self.failed = False

    def _carry_on(self):
        if not self.keeper.running:
            self.loop.quit()
        return self.keeper.running

    def _fail(self, exc):
        traceback.print_exc()
        self.failed = True
        try:
            self.keeper.stop(f"internal error: {exc}")
        except Exception:                 # cleanup's crash record still follows
            traceback.print_exc()
        self.loop.quit()
        return False

    def on_tick(self):
        try:
            self.keeper.tick()
            return self._carry_on()
        except Exception as exc:
            return self._fail(exc)

    def on_temp_tick(self):
        try:
            self.keeper.on_temp(self.hw.read_temp())
            return self._carry_on()
        except Exception as exc:
            return self._fail(exc)

    def on_released(self, _conn, _sender, _path, _iface, _signal, params):
        try:
            self.keeper.on_released(params.unpack()[0])
            self._carry_on()
        except Exception as exc:
            self._fail(exc)

    def on_sleep(self, _conn, _sender, _path, _iface, _signal, params):
        try:
            if not params.unpack()[0]:    # False: the machine just resumed
                self.keeper.on_resume()
                self._carry_on()
        except Exception as exc:
            self._fail(exc)

    def on_signal(self):
        try:
            self.keeper.on_terminate()
        except Exception as exc:
            return self._fail(exc)
        self.loop.quit()
        return False


def cmd_run(args):
    if not from_systemd():
        return 2
    if not 0 <= args.settle <= FAN_RELEASE_SECS:
        return 2
    hwmon = eco.find_hp_hwmon()
    if args.fans in ("max", "boost") and hwmon is None:
        now = int(time.time())
        FileStore().save_last({
            "ended_at": now, "reason": "unsupported: no hp fan control",
            # The wait this start inherited still applies to the next one.
            "fans_armed_until": now + args.settle if args.settle else None})
        return 1

    Gio, GLib = _gio()
    bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    hw = SysfsHw(hwmon, eco.read_path(eco.BOARD_NAME))
    keeper = Keeper(args.fans, hw, DbusPpd(bus), FileStore(), time,
                    LogindSession(bus, args.uid), settle=args.settle)
    loop = GLib.MainLoop()
    glue = KeeperLoop(keeper, hw, loop)

    # Only the daemons themselves may end or wake Max. Any local process can
    # send a signal, and a ProfileReleased cookie is a small number.
    bus.signal_subscribe(PPD_BUS_NAME, PPD_IFACE, "ProfileReleased", PPD_PATH,
                         None, Gio.DBusSignalFlags.NONE, glue.on_released)
    bus.signal_subscribe(LOGIND_BUS_NAME, LOGIND_IFACE, "PrepareForSleep",
                         LOGIND_PATH, None, Gio.DBusSignalFlags.NONE, glue.on_sleep)
    add_signal = _signal_add()
    for signum in (signal.SIGTERM, signal.SIGINT):
        add_signal(GLib.PRIORITY_DEFAULT, signum, glue.on_signal)

    if not keeper.start(os.getpid()):
        return 1
    GLib.timeout_add_seconds(KEEPALIVE_SECS, glue.on_tick)
    if args.fans == "boost":
        # Only boost looks at the temperature; auto and max add no wake-ups.
        GLib.timeout_add_seconds(TEMP_POLL_SECS, glue.on_temp_tick)
    loop.run()
    return 1 if glue.failed else 0


def crash_armed_until(state, now):
    """fans_armed_until for a keeper that died without writing its record:
    the one it last published - unless it was holding the profile at full
    speed, when the daemon's revert on the lost hold was one more 0x10."""
    armed = state.get("fans_armed_until")
    hot = "max" in (state.get("fans_state"), state.get("fans"))
    if hot and state.get("state") == "active":
        armed = now + FAN_RELEASE_SECS
    if isinstance(armed, bool) or not isinstance(armed, int) or armed <= now:
        return None
    return armed


def cmd_cleanup(args):
    """ExecStopPost: runs after every stop of the unit, clean or not."""
    if not from_systemd():
        return 2
    state = eco.read_json(eco.MAX_STATE_FILE)
    if state is not None:
        # The keeper did not get to clean up after itself: it crashed or was
        # killed. The daemon already dropped the hold along with the D-Bus
        # connection. The fans go back to automatic where that can be
        # written; on Victus-S they are left alone - the only "automatic"
        # there would stop them (see FANS_AUTO) - and the record says how
        # long the EC may still hold them at full speed, so that the next
        # session waits.
        now = int(time.time())
        result = os.environ.get("SERVICE_RESULT", "unknown")
        hw = SysfsHw.detect()
        if hw.can_auto:
            fans_to_auto(hw)
        FileStore().save_last({"ended_at": now,
                               "reason": f"stopped unexpectedly ({result})",
                               "fans_armed_until": None if hw.can_auto
                               else crash_armed_until(state, now)})
    FileStore().clear()
    # However Max ended - off, restart, a picked profile, logout, a crash -
    # Dynamic Boost it started goes with it, and the dGPU goes back to the
    # LACT profile it had before Max. `off` has done the latter already then.
    stop_powerd()
    ok, err, _ = eco.gpu_profile_give_back()
    if not ok:
        print(f"ecomode-max: cleanup could not put the LACT profile back: {err}",
              file=sys.stderr, flush=True)
    return 0


@locked
def cmd_watts(args):
    if args.action == "off":
        if not watts_active():
            eco.emit({"ok": True, "noop": True,
                      "msg": "watts sampler is already off"}, args)
            return 0
        sh(["systemctl", "stop", WATTS_UNIT])
        still = watts_active()
        eco.emit({"ok": not still,
                  "msg": "sampler did not stop" if still else "stopped"}, args)
        return 1 if still else 0

    if not WATTS_MIN_S <= args.interval <= WATTS_MAX_S:
        return fail(args, f"--interval must be {WATTS_MIN_S}..{WATTS_MAX_S} seconds")
    uid = invoking_uid()
    if uid is None:
        return fail(args, "cannot tell which user asked; run through pkexec")
    if not os.path.exists(f"{eco.RAPL}/energy_uj"):
        return fail(args, "no RAPL package energy counter on this machine")
    if not user_manager_active(uid):
        return fail(args, f"no running session for uid {uid}")

    if watts_active():
        current = eco.read_json(eco.WATTS_FILE) or {}
        if current.get("interval") == args.interval:
            eco.emit({"ok": True, "noop": True, "interval": args.interval}, args)
            return 0
        sh(["systemctl", "stop", WATTS_UNIT])

    eco.make_state_dir()
    sh(["systemctl", "reset-failed", WATTS_UNIT])
    res = sh(watts_run_cmd(uid, args.interval))
    if res.returncode != 0:
        return fail(args, "systemd-run failed: " + (res.stderr or "").strip())
    eco.emit({"ok": True, "interval": args.interval}, args)
    return 0


def cmd_watts_run(args):
    """The sampler loop: one averaged reading per interval into WATTS_FILE,
    for as long as the user is logged in."""
    if not from_systemd():
        return 2
    if not WATTS_MIN_S <= args.interval <= WATTS_MAX_S:
        return 2
    rng = eco.read_path(f"{eco.RAPL}/max_energy_range_uj")
    meter = WattMeter(int(rng) if rng and rng.isdigit() else None,
                      max_gap=3 * args.interval)
    gpu = GpuWatch() if os.path.exists(eco.DGPU) else None
    session = SdLoginSession(args.uid)

    def on_term(_signum, _frame):
        sys.exit(0)                 # interrupts the sleep; `finally` cleans up

    signal.signal(signal.SIGTERM, on_term)
    signal.signal(signal.SIGINT, on_term)
    try:
        # Lingering keeps the user manager, and BindsTo= with it, past the
        # logout; logind's state is read every round, as the keeper asks it.
        while session.alive() is not False:
            entry = watts_entry(meter, args.interval,
                                time.clock_gettime(time.CLOCK_BOOTTIME),
                                time.time(), gpu)
            if entry is not None:
                _write_json(eco.WATTS_FILE, entry)
            time.sleep(args.interval)
        return 0
    finally:
        # The temp file too: a SIGTERM can land between writing and renaming.
        for path in (eco.WATTS_FILE, eco.WATTS_FILE + ".tmp"):
            try:
                os.remove(path)
            except OSError:
                pass


def user_id(text):
    """--uid of run and watts-run: whose session the loop belongs to. A plain
    positive number that logind's 32-bit uid can carry: never root, and
    never (uid_t)-1."""
    if not (text.isascii() and text.isdigit()) or not 0 < int(text) < 2**32 - 1:
        raise argparse.ArgumentTypeError(f"not a user id: {text!r}")
    return int(text)


def build_parser():
    parser = argparse.ArgumentParser(
        prog="ecomode-max",
        description="Hold an HP OMEN in performance for this session only.")
    parser.add_argument("--json", action="store_true", help="machine-readable output")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_on = sub.add_parser("on", help="start Max (ends on logout or reboot)")
    p_on.add_argument("--fans", choices=FANS_MODES, default="auto",
                      help="auto: the firmware's curve; max: full speed; "
                           f"boost: full speed from {BOOST_ON_C} C")
    p_on.add_argument("--gpu-boost", action="store_true", dest="gpu_boost",
                      help="also run nvidia-powerd (Dynamic Boost) while Max is on")
    p_on.add_argument("--gpu-profile", dest="gpu_profile", default="",
                      help="the LACT profile to select for the dGPU while Max "
                           f"runs ('{eco.LACT_DEFAULT}' for LACT's own); the "
                           "previous one comes back when Max ends. Must be a "
                           "name LACT lists. Unset: the dGPU is left alone")
    p_on.set_defaults(func=cmd_on)

    sub.add_parser("off", help="stop Max (and put fans left at full speed back "
                   "to automatic, where that can be written)").set_defaults(func=cmd_off)

    p_fans = sub.add_parser("fans", help="the fans by hand while Max is off")
    p_fans.add_argument("mode", choices=["auto", "max"],
                        help="auto: the firmware's curve (not on Victus-S boards, "
                             "where the EC takes them back by itself); max: full speed")
    p_fans.set_defaults(func=cmd_fans)

    p_run = sub.add_parser("run", help="internal: the keep-alive, started by systemd")
    p_run.add_argument("--uid", type=user_id, required=True,
                       help="the user whose session Max belongs to")
    p_run.add_argument("--fans", choices=FANS_MODES, default="auto")
    p_run.add_argument("--settle", type=int, default=0,
                       help="seconds of silence first, while the EC takes back "
                            "fans an earlier session left at full speed")
    p_run.set_defaults(func=cmd_run)

    sub.add_parser("cleanup", help="internal: ExecStopPost of the unit"
                   ).set_defaults(func=cmd_cleanup)

    p_w = sub.add_parser("watts", help="CPU watts sampler for the widget (session only)")
    p_w.add_argument("action", choices=["on", "off"])
    p_w.add_argument("--interval", type=int, default=WATTS_DEFAULT_S,
                     help=f"seconds between readings, {WATTS_MIN_S}..{WATTS_MAX_S}")
    p_w.set_defaults(func=cmd_watts)

    p_wr = sub.add_parser("watts-run", help="internal: the sampler, started by systemd")
    p_wr.add_argument("--uid", type=user_id, required=True,
                      help="the user whose session the sampler belongs to")
    p_wr.add_argument("--interval", type=int, default=WATTS_DEFAULT_S)
    p_wr.set_defaults(func=cmd_watts_run)
    return parser


def main():
    args = build_parser().parse_args()
    if os.geteuid() != 0:
        print("ecomode-max: needs root (run through pkexec)", file=sys.stderr)
        return 2
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
