"""
ecomode - deeper-than-power-saver tuning layer.

Design notes
------------
* Every tunable is declared as data in KNOBS.  Apply, exact restore and
  self-test are all derived from that one declaration, so a knob can never
  be applied without also being restorable and testable.
* Knobs owned by power-profiles-daemon (EPP, platform_profile, governor)
  are declared with ppd_owned=True and are NEVER written.  PPD rewrites
  them on profile changes, so touching them would mean fighting the daemon
  and would break the slider in System Settings.  We only layer on top of
  knobs PPD leaves alone.
* The prior value of every path is recorded in STATE_FILE before the first
  write, so "off" restores byte-for-byte what was there - not a guessed
  default.
"""

import argparse
import contextlib
import fcntl
import functools
import glob as globmod
import json
import os
import shutil
import subprocess
import sys
import time

# tmpfs on purpose: none of these knobs survive a reboot, so neither should
# the record of them. A persistent state file would claim ECO was still on
# after a reboot that silently reset every value.
STATE_DIR = "/run/ecomode"
STATE_FILE = os.path.join(STATE_DIR, "state.json")

PSTATE = "/sys/devices/system/cpu/intel_pstate"
RAPL = "/sys/class/powercap/intel-rapl:0"
# The same package limits again, through the MMIO interface. Both are
# enforced, so the lower of the two is the one that binds.
RAPL_MMIO = "/sys/class/powercap/intel-rapl-mmio:0"
THROTTLE = "/sys/devices/system/cpu/cpu0/thermal_throttle"
MSR_PATH = "/dev/cpu/{cpu}/msr"
PCI_DEVICES = "/sys/bus/pci/devices"


def find_dgpu():
    """The NVIDIA display controller's sysfs directory, or a path that does
    not exist. Found by vendor and class rather than by address: the address
    differs between models."""
    for dev in sorted(globmod.glob(f"{PCI_DEVICES}/*")):
        try:
            with open(f"{dev}/vendor") as fh:
                vendor = fh.read().strip()
            with open(f"{dev}/class") as fh:
                klass = fh.read().strip()
        except OSError:
            continue
        if vendor == "0x10de" and klass.startswith("0x03"):
            return dev
    return f"{PCI_DEVICES}/no-nvidia-gpu"


DGPU = find_dgpu()

