    ("gr_mhz", "clocks.gr", int),
    ("mem_mhz", "clocks.mem", int),
    ("gr_max_mhz", "clocks.max.gr", int),
    ("mem_max_mhz", "clocks.max.mem", int),
    ("vram_used_mib", "memory.used", int),
    ("vram_total_mib", "memory.total", int),
    ("reasons_raw", "clocks_event_reasons.active", lambda v: int(v, 16)),
    ("name", "name", str),
]

# nvmlClocksEventReasons bits, as nvidia-smi reports them.
GPU_REASONS = [
    (0x004, "power cap"),
    (0x008, "hardware slowdown"),
    (0x020, "thermal (driver)"),
    (0x040, "thermal (hardware)"),
    (0x080, "power brake"),
    (0x002, "clock setting"),
    (0x100, "display clock"),
    (0x010, "sync boost"),
]


def run(argv, timeout=10):
    """(returncode, stdout, stderr); returncode None when it could not run."""
    try:
        res = subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.SubprocessError) as exc:
        return None, "", str(exc)
    return res.returncode, res.stdout, res.stderr


def nvsmi(*argv, timeout=10):
    if not shutil.which("nvidia-smi"):
        return None, "", "nvidia-smi not found"
    return run(["nvidia-smi", *argv], timeout=timeout)


def parse_gpu_csv(line):
    """One `nvidia-smi --query-gpu=... --format=csv,noheader,nounits` line as
    a dict over GPU_FIELDS; "[N/A]" and anything unparsable become None."""
    values = [v.strip() for v in line.split(",", len(GPU_FIELDS) - 1)]
    if len(values) != len(GPU_FIELDS):
        return None
    out = {}
    for (key, _, conv), raw in zip(GPU_FIELDS, values):
        try:
            out[key] = None if raw.startswith("[") or raw == "" else conv(raw)
        except ValueError:
            out[key] = None
    raw = out.get("reasons_raw")
    out["reasons"] = [] if raw is None else \
        [name for bit, name in GPU_REASONS if raw & bit]
    return out


def gpu_query():
    """What the dGPU is doing, or None. Talking to the driver wakes a
    sleeping GPU, so callers ask only while it is already awake."""
    fields = ",".join(f for _, f, _ in GPU_FIELDS)
    code, out, _ = nvsmi(f"--query-gpu={fields}", "--format=csv,noheader,nounits",
                         timeout=5)
    if code != 0 or not out.strip():
        return None
    return parse_gpu_csv(out.strip().split("\n")[0])


def gpu_runtime():
    """Runtime PM state from sysfs; reading it never wakes the GPU."""
    def ms(name):
        try:
            return int(read_path(f"{DGPU}/power/{name}"))
        except (TypeError, ValueError):
            return None
    return {"status": read_path(f"{DGPU}/power/runtime_status"),
            "suspended_ms": ms("runtime_suspended_time"),
            "active_ms": ms("runtime_active_time")}


def dgpu_connectors(enabled_only=False):
    """Display connectors the dGPU drives (connected, and enabled if asked)."""
    found = []
    for conn in sorted(globmod.glob("/sys/class/drm/card*-*")):
        if read_path(f"{conn}/status") != "connected":
            continue
        if enabled_only and read_path(f"{conn}/enabled") != "enabled":
            continue
        try:
            driver = os.path.basename(
                os.path.realpath(f"{conn}/../device/driver"))
        except OSError:
            driver = "?"
        if driver == "nvidia":
            found.append(os.path.basename(conn))
    return found


def dgpu_nodes():
    """Device nodes that reach the dGPU: /dev/nvidia* and its DRM card and
    render nodes (Vulkan and EGL clients often hold only the render node)."""
    nodes = set(globmod.glob("/dev/nvidia*"))
    addr = os.path.basename(DGPU)
    for kind in ("card", "render"):
        link = f"{DRI_BY_PATH}/pci-{addr}-{kind}"
        if os.path.exists(link):
            nodes.add(os.path.realpath(link))
    return nodes


def _comm(pid):
    return read_path(f"/proc/{pid}/comm") or "?"


def _ppid(pid):
    stat = read_path(f"/proc/{pid}/stat") or ""
    try:
        return int(stat.rsplit(")", 1)[1].split()[1])
    except (IndexError, ValueError):
        return None


def is_sensor_follower(pid, name):
    """KDE's GPU sensor: ksystemstats runs `nvidia-smi dmon` for as long as a
    widget subscribes. A widget that subscribes only while something else
    keeps the GPU busy (the patched Thermal Monitor) makes it a follower:
    it is not what keeps the card awake."""
    return name == "nvidia-smi" and _comm(_ppid(pid)) == "ksystemstats"


# The desktop itself. Xorg (also SDDM's greeter, which stays up after login),
# KWin, Xwayland and the Plasma shell keep /dev/nvidia* open for as long as
# they run - KWin 6.7 opens every GPU it finds, and plasmashell loads NVIDIA's
# EGL and Vulkan at start - yet the card powers down with them there. They
# keep it awake only while it drives a display. Counting them as holders made
# the watts sampler ask the driver every few seconds, and that did keep the
# card awake: measured, it slept 2 s after the sampler stopped.
DESKTOP_HOLDERS = ("Xorg", "kwin_wayland", "Xwayland", "plasmashell")


def holder_keeps_awake(name, hits, driving):
    """Whether a process with these dGPU nodes open keeps the card awake.
    `driving`: a display is connected to the dGPU."""
    if not any(t.startswith("/dev/nvidia") for t in hits):
        return False                  # the DRM card node alone never does
    return driving or name not in DESKTOP_HOLDERS


def holder_note(pid, name, awake):
    """Why a holder is there, when the name alone does not say."""
    if is_sensor_follower(pid, name):
        return ("KDE's GPU sensor (ksystemstats): keeps the GPU awake while "
                "a widget shows a GPU sensor")
    if name == "nvidia-smi":
        return f"started by {_comm(_ppid(pid))}"
    if not awake and name in DESKTOP_HOLDERS:
        return "the desktop: holds the card but lets it sleep (no display on it)"
    if not awake:
        return "display node only: does not keep it awake"
    if name in DESKTOP_HOLDERS:
        return "the desktop drives a display on the GPU"
    return None


def gpu_holders(exclude=()):
    """Processes holding a dGPU node. As a user this sees the user's own
    processes; as root, all of them.

    `awake`: it keeps the card out of D3cold (holder_keeps_awake): a client
    of the driver (/dev/nvidia*), unless it is the desktop and no display is
    on the dGPU. `follower`: KDE's GPU sensor, which a gated widget runs only
    while something else keeps the card awake.
    """
    nodes = dgpu_nodes()
    driving = bool(dgpu_connectors())
    by_name = {}
    for pid_dir in globmod.glob("/proc/[0-9]*"):
        pid = int(os.path.basename(pid_dir))
        if pid in exclude:
            continue
        try:
            fds = os.listdir(f"{pid_dir}/fd")
        except OSError:
            continue
        hits = set()
        for fd in fds:
            try:
                target = os.readlink(f"{pid_dir}/fd/{fd}")
            except OSError:
                continue
            if target in nodes:
                hits.add(target)
        if not hits:
            continue
        name = _comm(pid)
        awake = holder_keeps_awake(name, hits, driving)
        entry = by_name.get(name)
        if entry is None:
            by_name[name] = {"pid": pid, "name": name, "count": 1, "awake": awake,
                             "follower": is_sensor_follower(pid, name),
                             "note": holder_note(pid, name, awake)}
        else:
            entry["count"] += 1
            if awake and not entry["awake"]:
                entry.update(awake=True, note=holder_note(pid, name, True))
    return sorted(by_name.values(), key=lambda h: (not h["awake"], h["name"].lower()))


def keeps_awake(holders):
    """The holders that really keep the dGPU awake."""
    return [h for h in holders if h.get("awake") and not h.get("follower")]


def service_active(name):
    code, _, _ = run(["systemctl", "is-active", "--quiet", name], timeout=5)
    return code == 0


def dgpu_info(deep=False):
    """Who is keeping the discrete GPU awake, and what it is doing.

    deep=False is the routine path used by the panel widget: sysfs only.
    The expensive parts - walking every /proc/*/fd and asking nvidia-smi -
    are gated behind deep=True, and nvidia-smi is asked only while the GPU
    is awake anyway, because talking to the driver *wakes the GPU*. Polling
    it on a timer would keep the card permanently awake.
    """
    rt = gpu_runtime()
    info = {
        "present": os.path.exists(DGPU),
        "runtime_status": rt["status"],
        "control": read_path(f"{DGPU}/power/control"),
        "suspended_ms": rt["suspended_ms"],
        "active_ms": rt["active_ms"],
        "displays": dgpu_connectors(),
        "caps": read_json(GPU_FILE),
        "holders": [],
        "gpu": None,
        "power_w": None,
        "powerd": None,
        "deep": deep,
    }
    if not info["present"] or not deep:
        return info
    info["holders"] = gpu_holders()
    info["powerd"] = service_active("nvidia-powerd")
    if info["runtime_status"] == "active":
        info["gpu"] = gpu_query()
        if info["gpu"]:
            info["power_w"] = info["gpu"].get("power_w")
    return info


# --- clock caps for the deep levels ----------------------------------------

def save_gpu(rec):
    make_state_dir()
    tmp = GPU_FILE + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(rec, fh)
    os.chmod(tmp, 0o644)
    os.replace(tmp, GPU_FILE)


def clear_gpu():
    for path in (GPU_FILE, GPU_FILE + ".tmp"):
        try:
            os.remove(path)
        except OSError:
            pass


def gpu_controllable():
    """Clock locks need NVIDIA's own driver and nvidia-smi; with nouveau, or
    no NVIDIA card at all, the deep levels leave the GPU alone."""
    if not os.path.exists(DGPU) or not shutil.which("nvidia-smi"):
        return False
    try:
        return os.path.basename(os.path.realpath(f"{DGPU}/driver")) == "nvidia"
    except OSError:
        return False


def apply_gpu_caps(level, prev=None):
    """Lock the dGPU's clocks for `level`; returns the record to save, or
    None when the level has no GPU caps or there is no dGPU.

    A sleeping GPU is left asleep: the record says "pending" and the guard
    applies the locks once something wakes the card. The memory lock is
    skipped while a display hangs off the dGPU - scan-out at the lowest
    memory clock is the one place it could glitch.
    """
    caps = GPU_CAPS.get(level)
    if not caps or not gpu_controllable():
        return None
    prev = prev or {}
    rt = gpu_runtime()
    displays = dgpu_connectors()
    mem = caps["mem"] if not displays else None
    rec = {
        "level": level, "gr": caps["gr"], "mem": mem,
        "mem_skipped": "a display is on the dGPU" if caps["mem"] and displays else None,
        "applied": False, "pending": False, "error": None,
        # Whether a lock ever reached the driver, so `off` knows to reset.
        "gr_ever": bool(prev.get("gr_ever")),
        "mem_ever": bool(prev.get("mem_ever")),
        "slept_mark": rt["suspended_ms"],
        "at": int(time.time()),
    }
    if rt["status"] != "active":
        rec["pending"] = True
        return rec
    errors = []
    # Marked before the call and saved, so that a call cut short - the guard
    # stopped mid-way - still gets reset by `off`. Only a definite refusal
    # takes the mark back.
    gr_before, mem_before = rec["gr_ever"], rec["mem_ever"]
    rec["gr_ever"] = True
    rec["mem_ever"] = mem_before or bool(mem)
    save_gpu(rec)
    code, out, err = nvsmi("-lgc", f"{GPU_MIN_MHZ},{caps['gr']}")
    if code != 0:
        rec["gr_ever"] = gr_before
        errors.append("graphics clock: " + ((err or out).strip() or "failed"))
    if mem:
        code, out, err = nvsmi("-lmc", f"{mem},{mem}")
        if code != 0:
            rec["mem_ever"] = mem_before
            errors.append("memory clock: " + ((err or out).strip() or "failed"))
    elif rec["mem_ever"]:
        nvsmi("-rmc")            # a display came along: give memory its range back
        rec["mem_ever"] = False
    rec["applied"] = not errors
    rec["error"] = "; ".join(errors) or None
    rec["fails"] = int(prev.get("fails") or 0) + 1 if errors else 0
    return rec


def reset_gpu_caps(rec):
    """Undo what apply_gpu_caps did. Asks the driver only if a lock ever
    reached it - so a GPU that slept through Eco is not woken to undo
    nothing. Returns a list of errors."""
    errors = []
    if not rec:
        return errors
    if rec.get("gr_ever"):
        code, out, err = nvsmi("-rgc")
        if code != 0:
            errors.append("graphics clock: " + ((err or out).strip() or "failed"))
    if rec.get("mem_ever"):
        code, out, err = nvsmi("-rmc")
        if code != 0:
            errors.append("memory clock: " + ((err or out).strip() or "failed"))
    return errors


def guard_cmd():
    """systemd-run for the GPU guard: lives as long as a capped Eco level,
    locked down, writing only /run/ecomode."""
    return [
        "systemd-run", f"--unit={GPU_UNIT}", "--collect", "--quiet",
        "--description=Eco: keep the dGPU clock cap after it wakes",
        "-p", "NoNewPrivileges=yes", "-p", "ProtectHome=yes",
        "-p", "PrivateTmp=yes", "-p", "ProtectSystem=strict",
        "-p", f"ReadWritePaths={STATE_DIR}",
        "--", SELF_PATH, "gpu-guard",
    ]


def start_guard():
    if service_active(GPU_UNIT):
        return None
    make_state_dir()           # ReadWritePaths= fails the unit if it is missing
    run(["systemctl", "reset-failed", GPU_UNIT])
    code, _, err = run(guard_cmd())
    return None if code == 0 else ("could not start the GPU guard: " +
                                   (err.strip() or str(code)))


def gpu_on(level):
    """Clock caps for `level` plus the guard that keeps them. Returns the
    record (None when the level has none)."""
    rec = apply_gpu_caps(level, read_json(GPU_FILE))
    if rec is None:
        return None
    err = start_guard()
    if err:
        rec["error"] = "; ".join(e for e in (rec["error"], err) if e)
    save_gpu(rec)
    return rec


def gpu_off():
    """Stop the guard, then give the GPU its full clock range back."""
    run(["systemctl", "stop", GPU_UNIT])
    errors = reset_gpu_caps(read_json(GPU_FILE))
    clear_gpu()
    return errors


GUARD_RETRY_MAX_S = 600


def guard_due(rec, rt, now):
    """Whether the guard should lock the clocks now.

    The driver may drop a lock when the card powers off; runtime_suspended_time
    grows only while it is off, so a changed mark means it slept since. A
    lock the driver refused is retried after a sleep, or with a growing
    pause: asking every round would itself keep the card awake.
    """
    if rt["status"] != "active":
        return False
    if rec.get("slept_mark") != rt["suspended_ms"]:
        return True
    if rec.get("applied"):
        return False
    if not rec.get("error"):
        return True                       # pending: never tried while awake
    fails = max(1, int(rec.get("fails") or 1))
    wait = min(GUARD_RETRY_MAX_S, 30 * 2 ** (fails - 1))
    return now - int(rec.get("at") or 0) >= wait


def guard_round(now=None):
    """One guard round. False once there is nothing left to guard."""
    with state_lock():
        state = load_state()
        if not state or state.get("level") not in GPU_CAPS:
            return False
        rec = read_json(GPU_FILE) or {}
        if guard_due(rec, gpu_runtime(), time.time() if now is None else now):
            new = apply_gpu_caps(state["level"], rec)
            if new is not None:
                save_gpu(new)
        return True


def conf_log(args):
