DEFAULT_LEVEL = "gentle"

# gentle - caps only the sustained power budget (PL1). Bursts keep their full
#          budget, so race-to-idle survives and interactive work feels the
#          same. All 32 threads and the full turbo range stay available.
# deep   - also caps burst power (PL2), the frequency ceiling and the dGPU's
#          graphics clock. Nothing breaks and nothing is disturbed, but heavy
#          work takes longer.
# deepest - lower still: 20/25 W, a ceiling of at most 30%, the dGPU at
#          900 MHz and its memory at the lowest clock. For a machine left
#          alone, or a battery that has to last.
LEVELS = ["gentle", "deep", "deepest"]
# The settings spin box's range. intel_pstate clamps max_perf_pct to
# min_perf_pct (16 here) without an error, so a ceiling below that would read
# back as something Eco never wrote.
MAX_PCT_RANGE = (20, 100)

# Deliberately NOT included, after verifying each on this machine:
#   no_turbo            - base clock is 2200/5200 = 42% of max turbo, so
#                         max_perf_pct <= 42 already subsumes it. Saves ~0 at
#                         idle, can cost energy by breaking race-to-idle, and
#                         PPD uses it as its thermal-degradation sensor.
#   min_perf_pct        - silently clamped to 16 (the hardware floor).
#   hwp_dynamic_boost   - already 0.
#   ASPM policy         - "default" cannot be written back, so it is a
#                         one-way door and breaks the exact-restore promise.
#   USB autosuspend     - the hubs here carry keyboard and mouse receivers.
#   SATA link power     - no SATA controller on this machine.
#   core offlining      - idle cores already reach C6/C10; defeats Thread
#                         Director on this P+E part for <1 W.


# ---------------------------------------------------------------------------
# sysfs helpers
# ---------------------------------------------------------------------------

def expand(knob):
    """Return the list of concrete paths this knob covers."""
    if knob["kind"] == "glob":
        return sorted(globmod.glob(knob["path"]))
    return [knob["path"]] if os.path.exists(knob["path"]) else []


def read_path(path):
    try:
        with open(path) as fh:
            return fh.read().strip()
    except OSError:
        return None


def write_path(path, value):
    """Write value, return (ok, error). Never raises."""
    try:
        with open(path, "w") as fh:
            fh.write(str(value))
        return True, None
    except OSError as exc:
        return False, str(exc)


def read_knob(knob):
    """Current value: a single string, or None if unavailable.

    For glob knobs, returns the common value, or "mixed" if they differ.
    """
    paths = expand(knob)
    if not paths:
        return None
    values = {read_path(p) for p in paths}
    values.discard(None)
    if not values:
        return None
    if len(values) == 1:
        return values.pop()
    return "mixed"


def eco_value(knob, max_pct, level=None):
    """Target value for this knob, or None if it does not apply here.

    `eco` may be a plain value, a "{max_pct}" template, or a per-level dict
    for knobs whose target differs between gentle and deep.
    """
    eco = knob.get("eco")
    if eco is None:
        return None
    if isinstance(eco, dict):
        if level is None or level not in eco:
            return None
        eco = eco[level]
    return (str(eco).replace("{max_pct}", str(max_pct))
            .replace("{deepest_pct}", str(min(max_pct, DEEPEST_MAX_PCT))))


def humanize(knob, value):
    if value is None:
        return "n/a"
    mapping = knob.get("human")
    if mapping and value in mapping:
        return mapping[value]
    scale = knob.get("scale")
    if scale:
        try:
            return f"{int(value) / scale:g}{knob.get('unit', '')}"
        except (TypeError, ValueError):
            return str(value)
    return str(value) + knob.get("unit", "")


def available(knob):
    return bool(expand(knob))


def in_level(knob, level):
    eco = knob.get("eco")
    if isinstance(eco, dict):
        return level in eco
    return level in knob.get("levels", LEVELS)


def actionable(knob, level=None):
    """Knobs we are allowed to write at this level."""
    if knob["ppd_owned"] or knob.get("eco") is None or not available(knob):
        return False
    return True if level is None else in_level(knob, level)


# ---------------------------------------------------------------------------
# state
# ---------------------------------------------------------------------------

def load_state():
    try:
        with open(STATE_FILE) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


# Held by ecomode-max while it runs `ecomode off` under its own lock: the
# child must not wait for a lock its parent holds. pkexec clears the
# environment, so this cannot be passed in from an unprivileged caller.
LOCK_HELD_ENV = "ECOMODE_LOCK_HELD"


@contextlib.contextmanager
def state_lock():
    """An exclusive flock on /run/ecomode/lock, the same one ecomode-max
    takes: Eco and Max each read what is on and then act on it, and run side
    by side - two widgets, the widget and the CLI, the GPU guard - they
    would act on each other's stale view.

    Root's alone (0600 in a root-owned directory). The kernel lets go when
    the process dies.
    """
    if os.environ.get(LOCK_HELD_ENV) == "1":
        yield
        return
    make_state_dir()
    fd = os.open(os.path.join(STATE_DIR, "lock"),
                 os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)


def locked(command):
    @functools.wraps(command)
    def run(args):
        with state_lock():
            return command(args)
    return run


def make_state_dir():
    """STATE_DIR, world-readable whatever umask the caller has: the widget
    reads the state files here without privileges."""
    os.makedirs(STATE_DIR, exist_ok=True)
    os.chmod(STATE_DIR, 0o755)


def save_state(state):
    make_state_dir()
    tmp = STATE_FILE + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(state, fh, indent=2)
    os.replace(tmp, STATE_FILE)


def clear_state():
    try:
        os.remove(STATE_FILE)
    except OSError:
        pass


def is_on():
    return load_state() is not None


# ---------------------------------------------------------------------------
# Max mode, read-only side
# ---------------------------------------------------------------------------

def read_json(path):
    try:
        with open(path) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


def pid_alive(pid):
    return isinstance(pid, int) and pid > 0 and os.path.exists(f"/proc/{pid}")


def max_state():
    """The running Max keep-alive's published state, or None.

    A state file whose pid is gone is stale - the service died before it
    could clean up - and is treated as "not running".
    """
    state = read_json(MAX_STATE_FILE)
    if not state or not pid_alive(state.get("pid")):
        return None
    return state


def current_mode():
    if max_state() is not None:
        return "max"
    if is_on():
        return "eco"
    return "normal"


def find_hp_hwmon():
    """The hp-wmi hwmon directory, or None.

    hwmonN numbers are not stable across boots, so match on the name.
    """
    for d in sorted(globmod.glob(HWMON_GLOB)):
        if read_path(f"{d}/name") == "hp":
            return d
    return None


def fans_controllable():
    d = find_hp_hwmon()
    return d is not None and os.path.exists(f"{d}/pwm1_enable")


def fan_info():
    d = find_hp_hwmon()
    if d is None:
        return {"available": False, "rpm": [], "pwm_enable": None}
    rpm = []
    for path in sorted(globmod.glob(f"{d}/fan*_input")):
        try:
            rpm.append(int(read_path(path)))
        except (TypeError, ValueError):
            pass
    return {"available": os.path.exists(f"{d}/pwm1_enable"), "rpm": rpm,
            "pwm_enable": read_path(f"{d}/pwm1_enable")}


def on_ac():
    """True/False from the mains supply, or None if there is none to ask."""
    seen = False
    for d in sorted(globmod.glob(POWER_SUPPLY_GLOB)):
        if read_path(f"{d}/type") != "Mains":
            continue
        seen = True
        if read_path(f"{d}/online") == "1":
            return True
    return False if seen else None


def battery_draw_w():
    """Whole-laptop draw while discharging, in W; None on AC or unknown.

    On battery the pack feeds everything - CPU, screen, dGPU, SSD - so its
    discharge rate is the only whole-machine figure there is. On AC the
    adapter has no sensor, and power_now then reports charging, not draw.
    """
    for d in sorted(globmod.glob(POWER_SUPPLY_GLOB)):
        if read_path(f"{d}/type") != "Battery":
            continue
        if read_path(f"{d}/status") != "Discharging":
            return None
        try:
            return round(int(read_path(f"{d}/power_now")) / 1_000_000, 1)
        except (TypeError, ValueError):
            return None
    return None


def _watts(path):
    try:
        return round(int(read_path(path)) / 1_000_000, 1)
    except (TypeError, ValueError):
        return None


def _int(path):
    try:
        return int(read_path(path))
    except (TypeError, ValueError):
        return None


def cpu_model():
    """The CPU's name, without the vendor's marketing prefix."""
    try:
        with open("/proc/cpuinfo") as fh:
            for line in fh:
                if line.startswith("model name"):
                    name = line.split(":", 1)[1].strip()
                    for junk in ("(R)", "(TM)", "CPU ", "Processor"):
                        name = name.replace(junk, "")
                    name = name.split(" Gen Intel ")[-1].replace("Intel Core ", "Core ")
                    return " ".join(name.split())
    except OSError:
        pass
    return None


def cpu_tjmax_c():
    """Where the CPU starts throttling: coretemp's critical temperature for
    the package, None when there is no such sensor."""
    for d in sorted(globmod.glob(HWMON_GLOB)):
        if read_path(f"{d}/name") not in ("coretemp", "k10temp", "zenpower"):
            continue
        try:
            return int(read_path(f"{d}/temp1_crit")) // 1000
        except (TypeError, ValueError):
            return None
    return None


def cpu_info():
    """The CPU package's power limits and thermal throttling, all readable
    without root. What limits it *right now* needs MSR 0x64F, which only the
    root sampler can read (cpu_limit_now)."""
    pl = {"pl1_w": _watts(f"{RAPL}/constraint_0_power_limit_uw"),
          "pl2_w": _watts(f"{RAPL}/constraint_1_power_limit_uw"),
          "mmio_pl1_w": _watts(f"{RAPL_MMIO}/constraint_0_power_limit_uw"),
          "mmio_pl2_w": _watts(f"{RAPL_MMIO}/constraint_1_power_limit_uw")}
    for n in ("1", "2"):
        vals = [v for v in (pl[f"pl{n}_w"], pl[f"mmio_pl{n}_w"]) if v]
        pl[f"eff_pl{n}_w"] = min(vals) if vals else None
    pl["model"] = cpu_model()
    pl["tjmax_c"] = cpu_tjmax_c()
    pl["throttle_count"] = _int(f"{THROTTLE}/package_throttle_count")
    pl["throttle_ms"] = _int(f"{THROTTLE}/package_throttle_total_time_ms")
    return pl


# MSR_CORE_PERF_LIMIT_REASONS (0x64F): the low 16 bits say what holds the
# cores back at this moment (the high 16 are sticky log bits, left alone:
# clearing them would be a write). Intel SDM vol. 4, 2.17.
MSR_PERF_LIMIT_REASONS = 0x64F
CPU_LIMIT_BITS = [
    (1 << 10, "PL1"),
    (1 << 11, "PL2"),
    (1 << 1, "thermal"),
    (1 << 0, "PROCHOT"),
    (1 << 5, "avg thermal"),
    (1 << 6, "VR thermal"),
    (1 << 7, "VR current"),
    (1 << 8, "electrical"),
    (1 << 12, "turbo limit"),
    (1 << 13, "turbo attenuation"),
    (1 << 4, "residency"),
]


def read_msr(reg, cpu=0):
    """A 64-bit MSR, or None (not root, or no msr driver). Read-only."""
    try:
        fd = os.open(MSR_PATH.format(cpu=cpu), os.O_RDONLY)
    except OSError:
        return None
    try:
        data = os.pread(fd, 8, reg)
    except OSError:
        return None
    finally:
        os.close(fd)
    return int.from_bytes(data, "little") if len(data) == 8 else None


def decode_cpu_limits(value):
    if value is None:
        return None
    return [name for bit, name in CPU_LIMIT_BITS if value & bit]


def cpu_is_intel():
    try:
        with open("/proc/cpuinfo") as fh:
            for line in fh:
                if line.startswith("vendor_id"):
                    return line.split(":", 1)[1].strip() == "GenuineIntel"
    except OSError:
        pass
    return False


def cpu_limit_now():
    """What limits the CPU at this moment, e.g. ["PL1"], [] when nothing
    does; None without root, or on a CPU where 0x64F means something else."""
    if not cpu_is_intel():
        return None
    return decode_cpu_limits(read_msr(MSR_PERF_LIMIT_REASONS))


# ---------------------------------------------------------------------------
# battery and charge limit
# ---------------------------------------------------------------------------
# A charge limit through the kernel's standard charge_behaviour property:
# "inhibit-charge" at the stop level, "auto" again CHARGE_HYSTERESIS below.
# Any driver that offers both works (ThinkPad, some ASUS, HP boards with the
# hp-wmi patch in kernel/hp-wmi-charge); where neither is offered, the
# feature is simply not there. A root service keeps the window, also with
# nobody logged in, since charging overnight is when it matters.

CHARGE_DIR = "/var/lib/ecomode"           # persistent: the choice outlives a reboot
CHARGE_CONF = os.path.join(CHARGE_DIR, "charge.json")
CHARGE_UNIT = "ecomode-charge.service"
CHARGE_STOP_RANGE = (50, 95)
CHARGE_HYSTERESIS = 5
CHARGE_SECS = 30
CHARGE_AUTO, CHARGE_INHIBIT = "auto", "inhibit-charge"
# Battery care log (off by default): every decision, with its reason, goes to
# the journal under the identifier ecomode-charge (`journalctl -t
# ecomode-charge`), and a compact history - one line per change, never a
# timer's worth - feeds the popup's chart. Seven days are kept; the file is
# trimmed in place, so it stays one file of a few dozen KB.
CHARGE_HISTORY = os.path.join(CHARGE_DIR, "charge-history")
CHARGE_HISTORY_DAYS = 7
# With the log on, also the battery's capacity as its own controller estimates
# it (energy_full): one line whenever the estimate changes, and one a day. It
# changes only now and then, so this catches every change; 400 days of it is
# about 10 KB, enough to see how fast the battery ages over months.
CHARGE_HEALTH = os.path.join(CHARGE_DIR, "battery-health")
CHARGE_HEALTH_DAYS = 400
CHARGE_HEALTH_STEP = 0.1      # Wh: about 0.1 % of a laptop battery
CHARGE_STEP = 5               # a log line per 5 % while charging or discharging
CHARGE_HEARTBEAT = 3600       # and one an hour when nothing else happened
CHARGE_CONFIRM_SECS = 120     # firmware that has not followed a write by then
# Written by the sleep hook before suspend, marked "woke" after; the service
# then puts the pre-sleep charge mode back and removes it.
CHARGE_SLEEP_FILE = os.path.join(CHARGE_DIR, "charge-sleep.json")
# Charging is held over a suspend only on AC and from this level up. Lower,
# it charges as usual while asleep (possibly to 100 %), so a laptop put to
# sleep nearly flat does not wake up nearly flat.
CHARGE_SLEEP_FLOOR = 50


def find_battery():
    """The laptop's own battery: type Battery, not a device's (a mouse or a
    headset reports scope=Device), and present."""
    for d in sorted(globmod.glob(POWER_SUPPLY_GLOB)):
        if read_path(f"{d}/type") != "Battery":
            continue
        if read_path(f"{d}/scope") == "Device" or read_path(f"{d}/present") == "0":
            continue
        return d
    return None


def parse_behaviour(text):
    """charge_behaviour as sysfs shows it, "auto [inhibit-charge]": (the
    current mode, every mode offered)."""
    if not text:
        return None, []
    offered, current = [], None
    for word in text.split():
        if word.startswith("[") and word.endswith("]"):
            word = word[1:-1]
            current = word
        offered.append(word)
    return current, offered


def charge_supported(bat):
    _, offered = parse_behaviour(read_path(f"{bat}/charge_behaviour") if bat else None)
    return CHARGE_AUTO in offered and CHARGE_INHIBIT in offered


def load_charge_conf():
    conf = read_json(CHARGE_CONF) or {}
    stop = conf.get("stop")
    lo, hi = CHARGE_STOP_RANGE
    if isinstance(stop, bool) or not isinstance(stop, int) or not lo <= stop <= hi:
        stop = 80
    return {"enabled": conf.get("enabled") is True, "stop": stop,
            "log": conf.get("log") is True}


def save_charge_conf(conf):
    os.makedirs(CHARGE_DIR, exist_ok=True)
    os.chmod(CHARGE_DIR, 0o755)
    tmp = CHARGE_CONF + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(conf, fh)
    os.chmod(tmp, 0o644)
    os.replace(tmp, CHARGE_CONF)


def _uw(path):
    try:
        return int(read_path(path))
    except (TypeError, ValueError):
        return None


def battery_info():
    """Charge, health and charging mode of the laptop's battery; None when
    it has none. Sysfs only."""
    bat = find_battery()
    if bat is None:
        return None
    now, full, design = (_uw(f"{bat}/energy_{k}") for k in ("now", "full", "full_design"))
    power = _uw(f"{bat}/power_now")
    status = read_path(f"{bat}/status")
    current, offered = parse_behaviour(read_path(f"{bat}/charge_behaviour"))
    conf = load_charge_conf()
    info = {
        "name": os.path.basename(bat),
        "status": status,
        "capacity": _uw(f"{bat}/capacity"),
        "energy_wh": round(now / 1e6, 1) if now is not None else None,
        "full_wh": round(full / 1e6, 1) if full is not None else None,
        "design_wh": round(design / 1e6, 1) if design is not None else None,
        "health_pct": round(100 * full / design) if full and design else None,
        "cycles": _uw(f"{bat}/cycle_count") or None,     # 0 here means "not kept"
        "minutes_left": None,
        "charge_mode": current,
        "charge_supported": CHARGE_AUTO in offered and CHARGE_INHIBIT in offered,
        "limit": conf if conf["enabled"] else None,
        "limit_stop": conf["stop"],
        "limit_log": conf["log"],
    }
    if power and now is not None:
        if status == "Discharging":
            info["minutes_left"] = round(60 * now / power)
        elif status == "Charging" and full:
            target = full * (conf["stop"] / 100 if conf["enabled"] else 1)
            if target > now:
                info["minutes_left"] = round(60 * (target - now) / power)
    return info


def charge_decide(ac, capacity, current, stop):
    """The mode the window wants now, or None to leave it. On battery the
    flag means nothing and is cleared, so that nothing is left set by
    accident; between start and stop the current mode stays, which is what
    keeps it from flapping."""
    if ac is not True:
        return CHARGE_AUTO if current != CHARGE_AUTO else None
    if capacity is None:
        return None
    if capacity >= stop:
        want = CHARGE_INHIBIT
    elif capacity <= stop - CHARGE_HYSTERESIS:
        want = CHARGE_AUTO
    else:
        return None
    return want if want != current else None


def charge_round():
    """One service round: (written mode or None, error or None). Does
    nothing - and says so - when the battery offers no charge_behaviour."""
    bat = find_battery()
    if not charge_supported(bat):
        return None, "no charge_behaviour with auto and inhibit-charge"
    conf = load_charge_conf()
    current, _ = parse_behaviour(read_path(f"{bat}/charge_behaviour"))
    if not conf["enabled"]:
        want = CHARGE_AUTO if current != CHARGE_AUTO else None
    else:
        want = charge_decide(on_ac(), _uw(f"{bat}/capacity"), current, conf["stop"])
    if want is None:
        return None, None
    ok, err = write_path(f"{bat}/charge_behaviour", want)
    return (want, None) if ok else (None, f"{want}: {err}")


