@locked
def cmd_on(args):
    # Eco caps PL1; Max exists to lift the cap. Stacking them would leave
    # the widget showing one mode while the machine runs another.
    if max_state() is not None:
        emit({"ok": False, "msg": "max mode is on; turn it off first"}, args)
        return 1

    max_pct = args.max_pct
    level = args.level
    switched = False

    state = load_state()
    if state:
        if state.get("level") == level and state.get("max_pct") == max_pct:
            return reapply(state, args)
        # Switching level while on. Put every knob back to its recorded
        # original first, so the new level is captured against untouched
        # values rather than against the previous level's writes - otherwise
        # "off" would later restore the wrong numbers.
        _, revert_failed, _ = restore_all(state)
        gpu_off()
        if revert_failed:
            emit({"ok": False, "failed": revert_failed,
                  "msg": "could not revert the previous level"}, args)
            return 1
        clear_state()
        switched = True

    saved = {}
    written = {}
    applied = []
    failed = []

    # Measure immediately before and immediately after applying, a second
    # apart under the same workload. Comparing a reading taken now against
    # one taken at some other time would say more about what the machine
    # happened to be doing than about the effect of the knobs.
    # One-second windows: this runs without a password, and the energy
    # counter is root-only because finer readings leak what other code does.
    power_before = sample_power(POWER_WINDOW_S)

    for knob in KNOBS:
        if not actionable(knob, level):
            continue
        target = eco_value(knob, max_pct, level)
        paths = expand(knob)

        # Record prior value per concrete path BEFORE touching anything.
        saved[knob["id"]] = {p: read_path(p) for p in paths}

        errors = []
        for p in paths:
            ok, err = write_path(p, target)
            if not ok:
                errors.append(f"{p}: {err}")
            else:
                # What the kernel kept is what counts as ours later: it may
                # round or clamp the value it was given.
                written[p] = read_path(p)
        if errors:
            failed.append({"id": knob["id"], "errors": errors})
        else:
            applied.append(knob["id"])

    power_after = sample_power(POWER_WINDOW_S)

    # The state goes first: the GPU guard started below reads it.
    save_state({
        "since": int(time.time()),
        "level": level,
        "max_pct": max_pct,
        "power_before": power_before,
        "power_after": power_after,
        "knobs": saved,
        "written": written,
    })
    gpu = gpu_on(level)

    verdict = selftest("on", max_pct, level)
    emit({"ok": not failed and verdict["pass"], "level": level,
          "switched": switched,
          "applied": applied, "failed": failed, "selftest": verdict,
          "gpu": gpu,
          "power_before": power_before, "power_after": power_after}, args)
    return 0 if (not failed and verdict["pass"]) else 1


def ours(state, path, target):
    """The value Eco left at `path`: what the kernel read back after the
    write, or - for a state written before that was recorded - the target."""
    value = (state.get("written") or {}).get(path)
    return value if value is not None else target


def drifted(state):
    """Paths of applied knobs that no longer hold Eco's value, as
    [(knob, path, current, target)].

    hp-wmi rewrites RAPL on every platform_profile write - Fn+P, the KDE
    slider, power-profiles-daemon - so Eco can be undone under it while its
    state still says it is on.
    """
    level = state.get("level", DEFAULT_LEVEL)
    max_pct = state.get("max_pct", DEFAULT_MAX_PCT)
    out = []
    for knob in KNOBS:
        if not actionable(knob, level):
            continue
        target = eco_value(knob, max_pct, level)
        for path in expand(knob):
            current = read_path(path)
            if current is not None and current != ours(state, path, target):
                out.append((knob, path, current, target))
    return out


def reapply(state, args):
    """`on` with the level and ceiling already applied: put back whatever
    drifted. The drifted value is the firmware's baseline for the profile
    now in force, so it becomes the recorded original that `off` restores.
    Nothing drifted is a no-op."""
    level = state.get("level", DEFAULT_LEVEL)
    max_pct = state.get("max_pct", DEFAULT_MAX_PCT)
    repaired, failed = [], []
    for knob, path, current, target in drifted(state):
        state.setdefault("knobs", {}).setdefault(knob["id"], {})[path] = current
        ok, err = write_path(path, target)
        if ok:
            state.setdefault("written", {})[path] = read_path(path)
            repaired.append(knob["id"])
        else:
            failed.append({"id": knob["id"], "errors": [f"{path}: {err}"]})
    if repaired or failed:
        save_state(state)
    if level in GPU_CAPS and not service_active(GPU_UNIT):
        # The guard died or was stopped; bring it back.
        rec = gpu_on(level)
        if rec and rec.get("error"):
            failed.append({"id": "gpu_caps", "errors": [rec["error"]]})
    if not repaired and not failed:
        emit({"ok": True, "noop": True, "msg": "already on"}, args)
        return 0
    verdict = selftest("on", max_pct, level)
    ok = not failed and verdict["pass"]
    emit({"ok": ok, "level": level, "repaired": sorted(set(repaired)),
          "failed": failed, "selftest": verdict}, args)
    return 0 if ok else 1


def restore_all(state):
    """Write every recorded prior value back. Returns (restored, failed,
    kept).

    A path that no longer holds the value Eco wrote was changed since by
    someone else - usually the firmware, on a profile change - and is theirs
    now: it is left as it is and listed in `kept`.
    """
    level = state.get("level", DEFAULT_LEVEL)
    max_pct = state.get("max_pct", DEFAULT_MAX_PCT)
    restored, failed, kept = [], [], []
    for knob in KNOBS:
        entry = state.get("knobs", {}).get(knob["id"])
        if not entry:
            continue
        target = eco_value(knob, max_pct, level) if in_level(knob, level) else None
        errors = []
        for path, prior in entry.items():
            if prior is None:
                continue  # was unreadable before; leave it alone
            current = read_path(path)
            if (target is not None and current is not None
                    and current != ours(state, path, target)):
                kept.append(path)
                continue
            ok, err = write_path(path, prior)
            if not ok:
                errors.append(f"{path}: {err}")
        if errors:
            failed.append({"id": knob["id"], "errors": errors})
        else:
            restored.append(knob["id"])
    return restored, failed, kept


@locked
def cmd_off(args):
    state = load_state()
    if state is None:
        emit({"ok": True, "noop": True, "msg": "already off"}, args)
        return 0

    restored, failed, kept = restore_all(state)
    gpu_errors = gpu_off()
    verdict = verify_restore(state, kept)
    if not failed and verdict["pass"]:
        clear_state()

    # A clock lock the driver would not reset is reported, but does not keep
    # Eco "on": the CPU side is restored and verified.
    emit({"ok": not failed and verdict["pass"],
          "restored": restored, "failed": failed, "kept": kept,
          "gpu_errors": gpu_errors, "selftest": verdict}, args)
    return 0 if (not failed and verdict["pass"]) else 1


def compare_knob(knob, target, current):
    """Verify one knob. Returns (status, note); status is pass/fail/skipped.

    A naive written == read check gives false results on some knobs, so each
    declares its own comparator.
    """
    if current is None:
        return "skipped", "not readable on this machine"

    mode = knob.get("compare", "exact")

    if mode == "rapl":
        # Two separate failure modes here. The firmware may carry the RAPL
        # lock bit, in which case the write is rejected outright; or the HP
        # embedded controller may accept it and then rewrite the limit a
        # second later. A single read only catches the first, so read once
        # more after a pause and require both to agree.
        if current != target:
            return "fail", "firmware rejected the write (RAPL lock bit)"
        time.sleep(2)
        again = read_knob(knob)
        if again != target:
            return "fail", ("firmware rewrote it back to " +
                            humanize(knob, again))
        return "pass", None

    if mode == "advisory":
        # Value stuck, but the effect it permits is not guaranteed.
        return "pass", None

    return ("pass", None) if current == target else ("fail", "reads back " +
                                                     humanize(knob, current))


def selftest(expect, max_pct, level):
    """After apply: every applied knob must verify under its comparator."""
    checks = []
    for knob in KNOBS:
        if not actionable(knob, level):
            continue
        target = eco_value(knob, max_pct, level)
        current = read_knob(knob)
        status, note = compare_knob(knob, target, current)
        checks.append({
            "id": knob["id"], "label": knob["label"],
            "want": humanize(knob, target), "got": humanize(knob, current),
            "status": status, "note": note, "ok": status != "fail",
        })
    gpu = gpu_check(level)
    if gpu:
        checks.append(gpu)
    return {
        "phase": expect,
        "pass": all(c["ok"] for c in checks),
        "checks": checks,
    }


def gpu_check(level):
    """Self-test line for the dGPU clock cap. The driver offers no way to
    read a lock back, so this reports what the last attempt returned."""
    caps = GPU_CAPS.get(level)
    if not caps or not gpu_controllable():
        return None
    rec = read_json(GPU_FILE) or {}
    want = f"≤ {caps['gr']} MHz" + (f", VRAM {caps['mem']} MHz" if caps["mem"] else "")
    if rec.get("error"):
        status, note = "fail", rec["error"]
    elif rec.get("applied"):
        status, note = "pass", rec.get("mem_skipped")
    else:
        status, note = "skipped", "GPU asleep; capped when something wakes it"
    return {"id": "gpu_caps", "label": "dGPU clock cap", "want": want,
            "got": "locked" if rec.get("applied") else "-",
            "status": status, "note": note, "ok": status != "fail"}


def verify_restore(state, kept=()):
    """After restore: every path must equal the value recorded at apply time,
    except those left to whoever changed them since (restore_all's kept)."""
    checks = []
    for knob in KNOBS:
        entry = state.get("knobs", {}).get(knob["id"])
        if not entry:
            continue
        mismatched = []
        for path, prior in entry.items():
            if prior is None or path in kept:
                continue
            now = read_path(path)
            if now != prior:
                mismatched.append({"path": path, "want": prior, "got": now})
        checks.append({
            "id": knob["id"], "label": knob["label"],
            "status": "pass" if not mismatched else "fail",
            "note": None if not mismatched else "did not take the old value back",
            "ok": not mismatched, "mismatched": mismatched,
        })
    return {"phase": "off", "pass": all(c["ok"] for c in checks), "checks": checks}


def diagnostics():
    """Why ECO mode may be doing very little right now.

    Two effects dominate idle draw on this machine and neither is reachable
    from sysfs, so the honest thing is to report them rather than pretend a
    knob fixes them.
    """
    notes = []

    # Any enabled connector on the dGPU pins it out of D3cold - NVIDIA's RTD3
    # documentation states the GPU stays active while it drives a display.
    driving = dgpu_connectors(enabled_only=True)
    if driving:
        notes.append({
            "id": "dgpu_displays",
            "severity": "info",
            "text": (f"{len(driving)} display(s) are driven by the discrete "
                     "GPU, so it cannot reach D3cold. Its idle draw is a "
                     "hardware floor here, not a misconfiguration."),
            "detail": ", ".join(driving),
        })

    # Deep package C-states are what actually cut SoC idle power. An active
    # PCIe link (the dGPU above) keeps the package pinned in PC2/PC3.
    cst = read_path("/sys/kernel/debug/pmc_core/package_cstate_show")
    if cst:
        res = {}
        for line in cst.splitlines():
            if ":" in line:
                k, _, v = line.partition(":")
                try:
                    res[k.strip()] = int(v.strip())
                except ValueError:
                    pass
        total = sum(res.values()) or 1
        deep = sum(v for k, v in res.items()
                   if k.split()[-1] in ("C8", "C9", "C10"))
        if deep / total < 0.01:
            notes.append({
                "id": "package_cstates",
                "severity": "info",
                "text": ("The CPU package almost never reaches its deep "
                         "idle states (PC8-PC10), which is the single "
                         "largest idle power item. Same root cause as above."),
                "detail": f"deep residency {100 * deep / total:.2f}%",
            })

    return notes


def cmd_diagnostics(args):
    """Why ECO mode may be doing little. CLI only - too noisy for the panel."""
    notes = diagnostics()
    if getattr(args, "json", False):
        print(json.dumps({"notes": notes}))
    elif not notes:
        print("  nothing notable")
    else:
        for note in notes:
            print(f"  [{note['severity']}] {note['text']}")
            print(f"        {note['detail']}")
    return 0


@locked
def cmd_power(args):
    """On-demand package power measurement. Needs root for energy_uj."""
    watts = sample_power(args.seconds)
    state = load_state() or {}
    emit({
        "watts": watts,
        "seconds": args.seconds,
        "readable": watts is not None,
        "note": None if watts is not None else
                "energy_uj is root-only; run this through pkexec",
        "power_before": state.get("power_before"),
        "power_after": state.get("power_after"),
    }, args)
    return 0 if watts is not None else 1


def cmd_selftest(args):
    state = load_state()
    if state:
        verdict = selftest("on", state.get("max_pct", DEFAULT_MAX_PCT),
                           state.get("level", DEFAULT_LEVEL))
        verdict["applicable"] = True
    else:
        # Reporting "passed, 0 checks" here would be a lie dressed as a
        # success. Nothing was applied, so there is nothing to verify.
        verdict = {"phase": "off", "pass": None, "applicable": False,
                   "checks": [], "note": "eco mode is off; nothing to verify"}
    emit(verdict, args)
    return 0 if verdict["pass"] else 1


# ---------------------------------------------------------------------------
# output
# ---------------------------------------------------------------------------

def emit(data, args):
    if getattr(args, "json", False):
        print(json.dumps(data))
    else:
        print(render(data))


def render(data):
    lines = []
    if "knobs" in data and "on" in data:
        mode = data.get("mode") or ("eco" if data["on"] else "normal")
        state = {"eco": "ECO ON", "max": "MAX ON"}.get(mode, "normal")
        lines.append(f"  {state}   (PPD profile: {data.get('ppd_profile')}, "
                     f"CPU avg {data.get('cpu_avg_mhz')} MHz)")
        lines.append("")
        for k in data["knobs"]:
            tag = "[PPD]" if k["managed"] else ("[ECO]" if k["at_eco"] else "     ")
            lines.append(f"  {tag} {k['label']:<24} {k['current_human']}")
        before, after = data.get("power_before"), data.get("power_after")
        if before is not None and after is not None:
            delta = after - before
            sign = "+" if delta > 0 else ""
            lines.append("")
            lines.append(f"  package power at apply: {before} W -> {after} W "
                         f"({sign}{round(delta, 2)} W)")
        c = data.get("cpu") or {}
        if c.get("eff_pl1_w") is not None:
            lines.append("")
            lines.append(f"  CPU limits: PL1 {c['eff_pl1_w']:g} W, PL2 "
                         f"{c.get('eff_pl2_w') or 0:g} W  (MSR {c.get('pl1_w')}/"
                         f"{c.get('pl2_w')}, MMIO {c.get('mmio_pl1_w')}/"
                         f"{c.get('mmio_pl2_w')})")
        g = data.get("dgpu") or {}
        if g.get("present"):
            lines.append("")
            holders = ", ".join(h["name"] for h in g.get("holders", [])) or "none"
            draw = f"{g['power_w']} W" if g.get("power_w") is not None else "-"
            lines.append(f"  dGPU: {g.get('runtime_status')} ({draw})  held by: {holders}")
            q = g.get("gpu") or {}
            if q:
                lines.append(f"        {q.get('pstate')}, {q.get('util_pct')}% busy, "
                             f"{q.get('temp_c')} °C, {q.get('gr_mhz')}/"
                             f"{q.get('mem_mhz')} MHz, limit {q.get('limit_w')} W, "
                             f"VRAM {q.get('vram_used_mib')}/{q.get('vram_total_mib')} MiB")
            caps = g.get("caps") or {}
            if caps:
                state = ("locked" if caps.get("applied") else
                         "waiting for the GPU to wake" if caps.get("pending") else
                         caps.get("error") or "-")
                lines.append(f"        Eco clock cap {caps.get('gr')} MHz"
                             + (f", VRAM {caps['mem']} MHz" if caps.get("mem") else "")
                             + f": {state}")
    else:
        lines.append(json.dumps(data, indent=2))
    return "\n".join(lines)


def charge_stop(text):
    lo, hi = CHARGE_STOP_RANGE
    if not (text.isascii() and text.isdigit()) or not lo <= int(text) <= hi:
        raise argparse.ArgumentTypeError(f"must be a whole number {lo}..{hi}")
    return int(text)


def power_window(text):
    """`power --seconds`: 1..10. The RAPL counter is root-only because fine
    readings leak what other code does (PLATYPUS); without a password, one
    averaged reading per second is as fine as it gets - the same as the
    watts sampler's shortest interval."""
    try:
        value = float(text)
    except ValueError:
        raise argparse.ArgumentTypeError(f"not a number: {text!r}")
    if not 1 <= value <= 10:
        raise argparse.ArgumentTypeError("must be 1..10 seconds")
    return value


def main():
    parser = argparse.ArgumentParser(prog="ecomode")
    parser.add_argument("--json", action="store_true", help="machine-readable output")
    sub = parser.add_subparsers(dest="cmd")

    p_on = sub.add_parser("on", help="enter ECO mode")
    p_on.add_argument("--level", choices=LEVELS, default=DEFAULT_LEVEL,
                      help="gentle = invisible to running apps (default); "
                           "deep = also cap bursts, the frequency ceiling and "
                           "the dGPU clock; deepest = lower still")
    p_on.add_argument("--max-pct", type=int, default=DEFAULT_MAX_PCT,
                      dest="max_pct",
                      help="CPU ceiling percent for 'deep', 10..100 (default 40); "
                           f"'deepest' uses at most {DEEPEST_MAX_PCT}")
    p_on.set_defaults(func=cmd_on)

    sub.add_parser("off", help="restore previous values").set_defaults(func=cmd_off)

    p_st = sub.add_parser("status", help="show current state")
    p_st.add_argument("--deep", action="store_true",
                      help="also list dGPU holders and power draw "
                           "(wakes the dGPU - not for polling)")
    p_st.add_argument("--level", choices=LEVELS, default=DEFAULT_LEVEL,
                      help="level to compare against when eco is off")
    p_st.set_defaults(func=cmd_status)

    sub.add_parser("selftest", help="verify applied state").set_defaults(func=cmd_selftest)

    sub.add_parser("diagnostics",
                   help="why ECO may be doing little right now"
                   ).set_defaults(func=cmd_diagnostics)

    p_pw = sub.add_parser("power", help="measure package watts (needs root)")
    p_pw.add_argument("--seconds", type=power_window, default=1.0,
                      help="sampling window, 1..10 s (default 1)")
    p_pw.set_defaults(func=cmd_power)

    p_ch = sub.add_parser("charge", help="battery charge limit (needs a "
                          "charge_behaviour with inhibit-charge)")
    p_ch.add_argument("action", choices=["on", "off"])
    p_ch.add_argument("--stop", type=charge_stop, default=80,
                      help=f"stop charging at this %%, "
                           f"{CHARGE_STOP_RANGE[0]}..{CHARGE_STOP_RANGE[1]}; "
                           f"resume {CHARGE_HYSTERESIS} below (default 80)")
    p_ch.set_defaults(func=cmd_charge)

    p_ch.add_argument("--log", choices=["on", "off"], default=None,
                      help="battery care log: every decision to the journal "
                           "(journalctl -t ecomode-charge) and a 7-day history "
                           "for the chart; kept as saved when not given")

    p_hi = sub.add_parser("charge-history", help="battery care history for the chart")
    p_hi.add_argument("--hours", type=int, choices=[24, 168], default=24)
    p_hi.set_defaults(func=cmd_charge_history)

    sub.add_parser("charge-run", help="internal: the charge limit service, "
                   "started by systemd").set_defaults(func=cmd_charge_run)

    p_sl = sub.add_parser("charge-sleep", help="internal: the systemd-sleep hook")
    p_sl.add_argument("when", choices=["pre", "post"])
    p_sl.add_argument("kind", nargs="?", default="suspend")
    p_sl.set_defaults(func=cmd_charge_sleep)

    sub.add_parser("gpu-guard", help="internal: keeps the dGPU clock cap, "
                   "started by systemd").set_defaults(func=cmd_gpu_guard)

    args = parser.parse_args()
    if not args.cmd:
        args.func = cmd_status
        args.max_pct = DEFAULT_MAX_PCT
        args.level = DEFAULT_LEVEL
        args.deep = False

    if args.cmd in ("on", "off", "gpu-guard", "charge", "charge-run") and os.geteuid() != 0:
        print(f"ecomode: '{args.cmd}' needs root (run via pkexec)", file=sys.stderr)
        return 2

    # Without a password, root is not needed to read status or diagnostics -
    # and as root they would show every user's GPU processes and debugfs.
    if os.environ.get("PKEXEC_UID") and (
            args.cmd == "diagnostics" or (args.cmd == "status" and args.deep)):
        print(f"ecomode: run '{args.cmd}' without pkexec", file=sys.stderr)
        return 2

    lo, hi = MAX_PCT_RANGE
    if args.cmd == "on" and not (lo <= args.max_pct <= hi):
        print(f"ecomode: --max-pct must be {lo}..{hi}", file=sys.stderr)
        return 2

    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
