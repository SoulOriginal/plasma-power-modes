POWER_WINDOW_S = 1.0     # the finest reading handed out without a password


def sample_power(seconds=POWER_WINDOW_S):
    """Average package watts over `seconds`, or None if not permitted.

    RAPL exposes a monotonically increasing energy counter, so power is the
    slope: delta microjoules over delta seconds. `energy_uj` is root-only
    (a PLATYPUS side-channel mitigation), so this returns None when the
    helper runs unprivileged - which is the normal case for `status`.
    """
    path = f"{RAPL}/energy_uj"
    first = read_path(path)
    if first is None:
        return None

    start = time.monotonic()
    time.sleep(seconds)
    second = read_path(path)
    elapsed = time.monotonic() - start
    if second is None or elapsed <= 0:
        return None

    try:
        delta = int(second) - int(first)
    except (TypeError, ValueError):
        return None

    if delta < 0:
        # The counter wrapped; fold it back over its range.
        rng = read_path(f"{RAPL}/max_energy_range_uj")
        try:
            delta += int(rng)
        except (TypeError, ValueError):
            return None

    return round(delta / elapsed / 1_000_000, 2)


# power-profiles-daemon's names for the platform_profile values it sets on
# this machine. Any other value (quiet, cool, custom...) is left for the
# daemon itself to name.
PPD_PROFILE_NAMES = {"low-power": "power-saver", "balanced": "balanced",
                     "performance": "performance"}


def ppd_profile():
    """The power profile, read from platform_profile.

    The widget runs `status` while its popup is open, and powerprofilesctl
    is one more Python process per call; the sysfs file names the same
    profile for the values the daemon writes here.
    """
    name = PPD_PROFILE_NAMES.get(read_path(PLATFORM_PROFILE))
    return name if name is not None else ppd_profile_ctl()


def ppd_profile_ctl():
    if not shutil.which("powerprofilesctl"):
        return None
    try:
        out = subprocess.run(["powerprofilesctl", "get"],
                             capture_output=True, text=True, timeout=5)
        if out.returncode == 0:
            return out.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        pass
    return None


def cpu_avg_mhz():
    total = count = 0
    try:
        with open("/proc/cpuinfo") as fh:
            for line in fh:
                if line.startswith("cpu MHz"):
                    total += float(line.split(":")[1])
                    count += 1
    except (OSError, ValueError):
        return None
    return round(total / count) if count else None


