def charge_log_line(text, err=False):
    print(text, file=sys.stderr if err else sys.stdout, flush=True)


def cmd_charge_sleep(args):
    """The systemd-sleep hook (`pre`/`post` + the kind of sleep). While the
    machine sleeps nothing keeps the window, so before a suspend on AC at
    CHARGE_SLEEP_FLOOR or more, charging is held where it is, and after it the
    service puts the old mode back. On battery nothing is held: sleep can
    drain the battery flat, and nothing may be left stopping it from
    charging then. Hibernate is left alone: the machine is off then."""
    bat = find_battery()
    conf = load_charge_conf()
    if not (conf["enabled"] and charge_supported(bat)):
        return 0
    now = time.time()
    cur = charge_snapshot(bat)
    if args.when == "pre":
        if args.kind not in ("suspend", "suspend-then-hibernate"):
            return 0
        hold = (cur["ac"] is True and cur["cap"] is not None
                and cur["cap"] >= CHARGE_SLEEP_FLOOR)
        os.makedirs(CHARGE_DIR, exist_ok=True)
        with open(CHARGE_SLEEP_FILE, "w") as fh:
            json.dump({"t": now, "cap": cur["cap"], "mode": cur["mode"], "ac": cur["ac"],
                       "held": hold}, fh)
        if hold and cur["mode"] != CHARGE_INHIBIT:
            ok, err = write_path(f"{bat}/charge_behaviour", CHARGE_INHIBIT)
            if not ok:
                charge_log_line(f"could not hold charging for sleep: {err}", err=True)
                return 1
        if conf["log"]:
            if hold:
                why = (f"charging held while asleep (charge_behaviour = inhibit-charge), "
                       f"{cur['mode']} again on wake")
            elif cur["ac"] is True:
                why = (f"below {CHARGE_SLEEP_FLOOR} %, so it charges as usual while asleep "
                       f"(may pass {conf['stop']} %)")
            else:
                why = "nothing held: on battery it must stay free to charge"
            charge_log_line(f"going to sleep at {cur['cap']} %, {battery_state_text(cur)}: {why}")
            history_append(now, dict(cur, mode=CHARGE_INHIBIT) if hold else cur, "sleep")
        elif hold:
            charge_log_line(f"ecomode charge: inhibit-charge for sleep at {cur['cap']} %")
        return 0
    before = read_json(CHARGE_SLEEP_FILE)
    if not isinstance(before, dict) or before.get("woke"):
        return 0
    before["woke"] = True
    with open(CHARGE_SLEEP_FILE, "w") as fh:
        json.dump(before, fh)
    if conf["log"]:
        was = before.get("cap")
        took = duration_text(now - before["t"]) if isinstance(before.get("t"), (int, float)) else "?"
        after = (f"the service puts charge_behaviour back to {before.get('mode')} "
                 f"within {CHARGE_SECS} s" if before.get("held", True)
                 else "nothing was held")
        charge_log_line(f"woke up after {took}: battery {was} % -> {cur['cap']} %, "
                        f"{battery_state_text(cur)}; {after}")
    return 0


def charge_after_sleep(bat):
    """(woke, sleeping) from the sleep hook's file. On wake the pre-sleep
    mode goes back - charge_round decides from there - and the file goes."""
    before = read_json(CHARGE_SLEEP_FILE)
    if not isinstance(before, dict):
        return False, False
    if not before.get("woke"):
        return False, True
    mode = before.get("mode")
    # A file without "held" comes from a hook that always held.
    if before.get("held", True) and mode in (CHARGE_AUTO, CHARGE_INHIBIT):
        current, _ = parse_behaviour(read_path(f"{bat}/charge_behaviour"))
        if current != mode:
            write_path(f"{bat}/charge_behaviour", mode)
    with contextlib.suppress(OSError):
        os.remove(CHARGE_SLEEP_FILE)
    return True, False


def cmd_charge_history(args):
    """The history for the popup's chart: no root needed, the file is 0644."""
    now = time.time()
    conf = load_charge_conf()
    rows = history_read(now - args.hours * 3600)
    emit({"now": int(now), "hours": args.hours, "stop": conf["stop"],
          "resume": conf["stop"] - CHARGE_HYSTERESIS, "log": conf["log"],
          "enabled": conf["enabled"], "points": rows,
          "health": health_read(now - CHARGE_HEALTH_DAYS * 86400)}, args)
    return 0


def cmd_charge_run(args):
    """The service: keeps the window every CHARGE_SECS for as long as the
    limit is on. On stop it clears the inhibit unless the battery is at or
    above the stop level - then the limit holds over a shutdown, and no
    battery is ever left unable to charge below it."""
    if not os.environ.get("INVOCATION_ID"):
        print("ecomode: 'charge-run' is started by systemd only", file=sys.stderr)
        return 2
    import signal

    def on_term(_signum, _frame):
        sys.exit(0)

    signal.signal(signal.SIGTERM, on_term)
    signal.signal(signal.SIGINT, on_term)
    last_error, watch, last_trim, logging = None, ChargeWatch(), 0.0, None
    health_last = (health_read() or [None])[-1]
    # A fresh start cannot be in the middle of a suspend: a leftover from a
    # sleep the machine never woke from is stale.
    with contextlib.suppress(OSError):
        os.remove(CHARGE_SLEEP_FILE)
    try:
        while True:
            conf = load_charge_conf()
            bat = find_battery()
            woke, sleeping = charge_after_sleep(bat) if bat else (False, False)
            written, error = charge_round()
            now = time.time()
            if conf["log"] != logging:
                if logging is not None:
                    charge_log_line("battery care log " + ("on" if conf["log"] else "off"))
                logging, watch = conf["log"], ChargeWatch()
            if conf["log"] and bat:
                lines, event = watch.observe(now, charge_snapshot(bat), written, conf,
                                             slept=woke, sleeping=sleeping)
                for line in lines:
                    charge_log_line(line, err=line.startswith("warning"))
                if event is not None:
                    history_append(now, watch.prev, event or None)
                health_last, line = health_round(bat, now, health_last)
                if line:
                    charge_log_line(line)
                if now - last_trim >= CHARGE_HEARTBEAT:
                    history_trim(now)
                    trim_rows(CHARGE_HEALTH, parse_health_line, now, CHARGE_HEALTH_DAYS)
                    last_trim = now
            elif written:
                charge_log_line(f"ecomode charge: {written} at "
                                f"{read_path(f'{bat}/capacity')} %")
            if error != last_error and error:
                charge_log_line(f"ecomode charge: {error}", err=True)
            last_error = error
            if not conf["enabled"]:
                return 0             # charge_round has put it back to auto
            time.sleep(CHARGE_SECS)
    finally:
        bat = find_battery()
        conf = load_charge_conf()
        capacity = _uw(f"{bat}/capacity") if bat else None
        if charge_supported(bat) and not (conf["enabled"] and capacity is not None
                                          and capacity >= conf["stop"]):
            write_path(f"{bat}/charge_behaviour", CHARGE_AUTO)


def cmd_gpu_guard(args):
