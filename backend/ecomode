def charge_snapshot(bat):
    """What the log and the chart need from one reading of the battery."""
    current, _ = parse_behaviour(read_path(f"{bat}/charge_behaviour"))
    power = _uw(f"{bat}/power_now")
    return {"cap": _uw(f"{bat}/capacity"), "ac": on_ac(), "mode": current,
            "status": read_path(f"{bat}/status"),
            "power_w": round(power / 1e6, 1) if power else None}


def duration_text(secs):
    secs = max(0, int(secs))
    if secs < 60:
        return f"{secs} s"
    h, m = divmod(secs // 60, 60)
    return f"{h} h {m:02d} min" if h else f"{m} min"


def battery_state_text(s):
    """"charging at 31.2 W, on AC" and the like - one reading, in words."""
    power = f" at {s['power_w']} W" if s.get("power_w") else ""
    src = "on AC" if s.get("ac") is True else "on battery" if s.get("ac") is False else "power source unknown"
    st = s.get("status")
    if st == "Charging":
        what = "charging" + power
    elif st == "Discharging":
        what = "discharging" + power
    elif s.get("mode") == CHARGE_INHIBIT and s.get("ac") is True:
        what = "held, not charging"
    else:
        what = (st or "unknown status").lower()
    return f"{what}, {src}"


# One letter per field keeps a history line about 25 bytes.
_HIST_STATUS = {"Charging": "C", "Discharging": "D", "Not charging": "N", "Full": "F"}
_HIST_STATUS_BACK = {v: k for k, v in _HIST_STATUS.items()}


def history_line(t, s, event=None):
    ac = {True: "1", False: "0"}.get(s.get("ac"), "-")
    mode = {CHARGE_AUTO: "a", CHARGE_INHIBIT: "i"}.get(s.get("mode"), "-")
    cap = s.get("cap")
    return (f"{int(t)} {cap if cap is not None else '-'} {ac} {mode} "
            f"{_HIST_STATUS.get(s.get('status'), 'U')} {event or '-'}\n")


def parse_history_line(line):
    """[t, capacity, ac, mode, status, event] or None for a damaged line."""
    parts = line.split()
    if len(parts) != 6:
        return None
    try:
        t = int(parts[0])
        cap = None if parts[1] == "-" else int(parts[1])
    except ValueError:
        return None
    return [t, cap, {"1": True, "0": False}.get(parts[2]),
            {"a": CHARGE_AUTO, "i": CHARGE_INHIBIT}.get(parts[3]),
            _HIST_STATUS_BACK.get(parts[4], "Unknown"),
            None if parts[5] == "-" else parts[5]]


def append_line(path, text):
    """One line onto a history file, under a lock since the sleep hook
    writes too. True if it was written; a failed write costs a point."""
    try:
        os.makedirs(CHARGE_DIR, exist_ok=True)
        fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
        with os.fdopen(fd, "a") as fh:
            fcntl.flock(fh, fcntl.LOCK_EX)
            fh.write(text)
        return True
    except OSError:
        return False


def read_rows(path, parse, since=0):
    """The parsed rows of a history file from `since` on; damaged lines skipped."""
    try:
        with open(path) as fh:
            rows = [parse(ln) for ln in fh]
    except OSError:
        return []
    return [r for r in rows if r is not None and r[0] >= since]


def trim_rows(path, parse, now, days):
    """Drop what is older than `days`, rewriting the file in place."""
    cutoff = now - days * 86400
    try:
        with open(path, "r+") as fh:
            fcntl.flock(fh, fcntl.LOCK_EX)
            lines = fh.readlines()
            keep = [ln for ln in lines
                    if (p := parse(ln)) is not None and p[0] >= cutoff]
            if len(keep) != len(lines):
                fh.seek(0)
                fh.writelines(keep)
                fh.truncate()
    except OSError:
        pass


def history_append(t, s, event=None):
    return append_line(CHARGE_HISTORY, history_line(t, s, event))


def history_read(since):
    return read_rows(CHARGE_HISTORY, parse_history_line, since)


def history_trim(now, days=CHARGE_HISTORY_DAYS):
    trim_rows(CHARGE_HISTORY, parse_history_line, now, days)


def battery_capacity_wh(bat):
    """(full, design) in Wh as the battery's controller reports them, or
    (None, None) where it reports energy in another way (charge_full)."""
    full, design = _uw(f"{bat}/energy_full"), _uw(f"{bat}/energy_full_design")
    if not full or not design:
        return None, None
    return round(full / 1e6, 2), round(design / 1e6, 2)


def parse_health_line(line):
    """[t, full Wh, design Wh] or None for a damaged line."""
    parts = line.split()
    if len(parts) != 3:
        return None
    try:
        return [int(parts[0]), float(parts[1]), float(parts[2])]
    except ValueError:
        return None


def health_due(last, now, full_wh):
    """A capacity line is due when the estimate moved by CHARGE_HEALTH_STEP
    or more, or on a new day. The step keeps a controller that jitters by a
    few mWh from writing a line every round."""
    if last is None or abs(last[1] - full_wh) >= CHARGE_HEALTH_STEP:
        return True
    return time.localtime(last[0])[:3] != time.localtime(now)[:3]


def health_append(t, full_wh, design_wh):
    return append_line(CHARGE_HEALTH, f"{int(t)} {full_wh:.2f} {design_wh:.2f}\n")


def health_read(since=0):
    return read_rows(CHARGE_HEALTH, parse_health_line, since)


def health_round(bat, now, last):
    """One capacity check for the service: (new last row, log line or None)."""
    full, design = battery_capacity_wh(bat)
    if full is None or not health_due(last, now, full):
        return last, None
    if not health_append(now, full, design):
        return last, None             # not written: try again next round
    line = None
    if last is not None and abs(last[1] - full) >= CHARGE_HEALTH_STEP:
        line = (f"battery capacity estimate changed: {last[1]:.2f} -> {full:.2f} Wh "
                f"({100 * full / design:.1f} % of the {design:.0f} Wh design)")
    elif last is None:
        line = (f"battery capacity: {full:.2f} Wh, {100 * full / design:.1f} % of the "
                f"{design:.0f} Wh design (recorded daily and on every change)")
    return [int(now), full, design], line


class ChargeWatch:
    """Turns successive readings into log lines that say what happened and
    why, plus a history event name for the chart. Pure: the caller reads the
    battery and the clock, and prints what comes back."""

    def __init__(self):
        self.prev = None
        self.bucket = None          # capacity // CHARGE_STEP at the last step line
        self.last_line = 0.0
        self.pending = None         # (mode written, when) until the firmware follows

    def observe(self, now, cur, written, conf, slept=False, sleeping=False):
        """(lines, event): lines for the journal, event for the history (or
        None when nothing worth a chart point changed). `slept`: the machine
        has just woken, and the sleep hook has logged it; `sleeping`: the hook
        has held charging for a suspend that is under way."""
        stop, resume = conf["stop"], conf["stop"] - CHARGE_HYSTERESIS
        cap, prev = cur.get("cap"), self.prev
        lines, event = [], None
        if prev is None:
            lines.append(f"watching: limit {stop} %, resume at {resume} %; "
                         f"battery {cap} %, {battery_state_text(cur)}")
            event = "start"
        elif slept:
            # The sleep hook has already said what it did; only start afresh.
            event = "wake"
        else:
            if cur["ac"] != prev["ac"]:
                if cur["ac"] is True:
                    lines.append(f"AC plugged in at {cap} %" + (
                        f": charging up to {stop} %" if cap is not None and cap < stop
                        else f": at or above the {stop} % limit, holding"))
                    event = "plug"
                else:
                    lines.append(f"AC unplugged at {cap} %: running on battery")
                    event = "unplug"
            elif cur["mode"] != prev["mode"] and written is None and not sleeping:
                lines.append(f"warning: charge_behaviour changed outside this service: "
                             f"{prev['mode']} -> {cur['mode']} at {cap} %")
                event = "outside"
        if written == CHARGE_INHIBIT:
            lines.append(f"charging stopped at {cap} %: reached the {stop} % limit "
                         f"(charge_behaviour = inhibit-charge); resumes at {resume} %")
            event = "stop"
        elif written == CHARGE_AUTO and not conf["enabled"]:
            lines.append(f"limit switched off at {cap} %: charging normally to 100 %")
            event = "off"
        elif written == CHARGE_AUTO and cur["ac"] is True:
            lines.append(f"charging resumed at {cap} %: down to the {resume} % resume level "
                         f"(charge_behaviour = auto); stops again at {stop} %")
            event = "resume"
        elif written == CHARGE_AUTO:
            lines.append(f"charge hold cleared at {cap} %: not needed on battery "
                         f"(charge_behaviour = auto)")
            event = event or "clear"
        if written:
            self.pending = (written, now)
        lines += self._confirm(now, cur)
        # Every CHARGE_STEP % while the charge moves; one line an hour else.
        bucket = cap // CHARGE_STEP if cap is not None else None
        moving = cur.get("status") in ("Charging", "Discharging")
        if prev is not None and not slept and bucket != self.bucket and moving and not lines:
            lines.append(f"battery {cap} %, {battery_state_text(cur)}")
        if slept:
            self.last_line = now     # asleep is not "no change": count afresh
        if not lines and now - self.last_line >= CHARGE_HEARTBEAT:
            lines.append(f"no change for {duration_text(now - self.last_line)}: "
                         f"battery {cap} %, {battery_state_text(cur)}")
            # A chart point too: the chart trusts a reading for an hour.
            event = "" if event is None else event
        if lines:
            self.last_line = now
            self.bucket = bucket
        if event is None and (prev is None or any(
                cur.get(k) != prev.get(k) for k in ("cap", "ac", "mode", "status"))):
            event = ""              # a plain chart point, no named event
        self.prev = dict(cur)
        return lines, event

    def _confirm(self, now, cur):
        """Did the battery follow the last write? Says so once, with how long
        it took, or warns once when it has not after CHARGE_CONFIRM_SECS."""
        if self.pending is None:
            return []
        mode, since = self.pending
        if cur.get("mode") != mode or cur.get("ac") is not True:
            self.pending = None          # overtaken, or unplugged: nothing to confirm
            return []
        st = cur.get("status")
        took = duration_text(now - since)
        if mode == CHARGE_INHIBIT and st != "Charging":
            self.pending = None
            return [f"firmware followed: battery {st.lower() if st else 'idle'} after {took}"]
        if mode == CHARGE_AUTO and st in ("Charging", "Full"):
            self.pending = None
            return [f"firmware followed: battery {st.lower()} after {took}"]
        if now - since >= CHARGE_CONFIRM_SECS:
            self.pending = None
            return [f"warning: charge_behaviour is {mode} but the battery still reports "
                    f"{st} after {took}"]
        return []


